<UserControl x:Class="HCB.UI.SeqSidebar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:HCB.UI"
      mc:Ignorable="d">

            <Grid Width="420">
                <!-- Handle strip -->
                <Border HorizontalAlignment="Left" Width="16"
                        Background="#152238" CornerRadius="6,0,0,6" Opacity="0.8">
                    <Path Data="M 9 6 L 4 12 L 9 18"
                          Stroke="#3498DB" StrokeThickness="1.5" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Content panel -->
                <Border Margin="16,0,0,0" Background="#0D1B2A"
                        BorderBrush="#1C3A52" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,16,16,16">

                            <local:SettingsSidebar Margin="0,0,0,14"/>

                            <!-- Vacuum OFF Buttons -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Height="38" Cursor="Hand"
                                        Command="{Binding HeaderVacOffCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="#4A1A1A"
                                                    BorderBrush="#8C2A2A" BorderThickness="1" CornerRadius="6">
                                                <TextBlock Text="Header Vac OFF" Foreground="#ECF0F1"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#6A2A2A"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#E74C3C"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Grid.Column="2" Height="38" Cursor="Hand"
                                        Command="{Binding WaferVacOffCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="#4A1A1A"
                                                    BorderBrush="#8C2A2A" BorderThickness="1" CornerRadius="6">
                                                <TextBlock Text="Wafer Vac OFF" Foreground="#ECF0F1"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#6A2A2A"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#E74C3C"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- W Table 2D Mapping Toggle -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Height="38" Cursor="Hand"
                                        Command="{Binding ToggleWTableMappingCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd"
                                                                Background="#1A2332"
                                                                BorderBrush="#2A3A4A"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="14,4">
                                                            <StackPanel Orientation="Horizontal"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock x:Name="Ico" Text="○ "
                                                                           Foreground="#8899AA" FontSize="14"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="Txt"
                                                                           Text="W Table Map OFF"
                                                                           Foreground="#8899AA"
                                                                           FontSize="13" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsWTableMappingOn}" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#0F6E56"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1D9E75"/>
                                                                <Setter TargetName="Ico" Property="Text" Value="● "/>
                                                                <Setter TargetName="Ico" Property="Foreground" Value="#2ECC71"/>
                                                                <Setter TargetName="Txt" Property="Text" Value="W Table Map ON"/>
                                                                <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Grid.Column="2" Height="38" Cursor="Hand"
                                        Command="{Binding TogglePTableMappingCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd"
                                                                Background="#1A2332"
                                                                BorderBrush="#2A3A4A"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="14,4">
                                                            <StackPanel Orientation="Horizontal"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock x:Name="Ico" Text="○ "
                                                                           Foreground="#8899AA" FontSize="14"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="Txt"
                                                                           Text="P Table Map OFF"
                                                                           Foreground="#8899AA"
                                                                           FontSize="13" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsPTableMappingOn}" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#0F6E56"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1D9E75"/>
                                                                <Setter TargetName="Ico" Property="Text" Value="● "/>
                                                                <Setter TargetName="Ico" Property="Foreground" Value="#2ECC71"/>
                                                                <Setter TargetName="Txt" Property="Text" Value="P Table Map ON"/>
                                                                <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!-- Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="#14452A" CornerRadius="4" Padding="10,4"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="RESULT" Foreground="#2ECC71" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="Vernier Measurement"
                                           Foreground="#ECF0F1" FontSize="18" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Rectangle Height="1" Fill="#1C3A52" Margin="0,0,0,14"/>


                            <!-- Offset Summary -->
                            <Border Background="#060F1A" CornerRadius="6"
                                    BorderBrush="#1C3A52" BorderThickness="1"
                                    Padding="16,12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                               Text="Offset" Foreground="#2ECC71"
                                               FontSize="14" FontWeight="Bold"/>

                                    <TextBlock Grid.Row="2" Text="Offset X"
                                               Foreground="#5E8BAA" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               FontSize="18" FontFamily="Consolas" FontWeight="Bold"
                                               Foreground="#ECF0F1" VerticalAlignment="Center"
                                               Text="{Binding VernierResult.OffsetX, StringFormat={}{0:F4}, TargetNullValue='--'}"/>

                                    <TextBlock Grid.Row="4" Text="Offset Y"
                                               Foreground="#5E8BAA" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1"
                                               FontSize="18" FontFamily="Consolas" FontWeight="Bold"
                                               Foreground="#ECF0F1" VerticalAlignment="Center"
                                               Text="{Binding VernierResult.OffsetY, StringFormat={}{0:F4}, TargetNullValue='--'}"/>

                                    <TextBlock Grid.Row="6" Text="Offset T"
                                               Foreground="#5E8BAA" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1"
                                               FontSize="18" FontFamily="Consolas" FontWeight="Bold"
                                               Foreground="#ECF0F1" VerticalAlignment="Center"
                                               Text="{Binding VernierResult.OffsetT, StringFormat={}{0:F4}, TargetNullValue='--'}"/>
                                </Grid>
                            </Border>

                            <!-- Vernier DataGrid -->
                            <TextBlock Text="Measurement Data" Foreground="#5E8BAA"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,14,0,6"/>
                            <Border Background="#060F1A" CornerRadius="6"
                                    BorderBrush="#1C3A52" BorderThickness="1">
                                <DataGrid ItemsSource="{Binding VernierRows}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          Background="Transparent" BorderThickness="0"
                                          RowBackground="Transparent"
                                          AlternatingRowBackground="#0A1628"
                                          Foreground="#ECF0F1" FontSize="13" FontFamily="Consolas"
                                          CanUserResizeRows="False" CanUserAddRows="False"
                                          GridLinesVisibility="None" RowHeaderWidth="0"
                                          ColumnHeaderHeight="26" RowHeight="24"
                                          MaxHeight="200">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="Background" Value="#0A1628"/>
                                            <Setter Property="Foreground" Value="#2ECC71"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#1C3A52"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell"
                                               BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="8,2"/>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Pos"  Binding="{Binding Name}"                       Width="36"/>
                                        <DataGridTextColumn Header="V1-X" Binding="{Binding V1X, StringFormat={}{0:F3}}" Width="78"/>
                                        <DataGridTextColumn Header="V1-Y" Binding="{Binding V1Y, StringFormat={}{0:F3}}" Width="78"/>
                                        <DataGridTextColumn Header="V3-X" Binding="{Binding V3X, StringFormat={}{0:F3}}" Width="78"/>
                                        <DataGridTextColumn Header="V3-Y" Binding="{Binding V3Y, StringFormat={}{0:F3}}" Width="78"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- ── FIDUCIAL ANGLE TRACKING ── -->
                            <Rectangle Height="1" Fill="#1C3A52" Margin="0,16,0,14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="#1A3A5C" CornerRadius="4" Padding="10,4"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="ANGLE" Foreground="#3498DB" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="Fiducial Angle Tracking"
                                           Foreground="#ECF0F1" FontSize="18" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Height="38" Cursor="Hand" Margin="0,0,0,14"
                                    Command="{Binding RunFiducialAngleTrackingCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="#1A3A5C"
                                                BorderBrush="#2A5A8C" BorderThickness="1" CornerRadius="6">
                                            <TextBlock Text="각도 추적 START" Foreground="#ECF0F1"
                                                       FontSize="14" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2A5A8C"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3498DB"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Border Background="#060F1A" CornerRadius="6"
                                    BorderBrush="#1C3A52" BorderThickness="1"
                                    Padding="16,12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                               Text="Fiducial Angle" Foreground="#3498DB"
                                               FontSize="14" FontWeight="Bold"/>

                                    <TextBlock Grid.Row="2" Text="PC Table"
                                               Foreground="#5E8BAA" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               FontSize="18" FontFamily="Consolas" FontWeight="Bold"
                                               Foreground="#ECF0F1" VerticalAlignment="Center"
                                               Text="{Binding FiducialPcAngle, StringFormat={}{0:F6}°}"/>

                                    <TextBlock Grid.Row="4" Text="Hc"
                                               Foreground="#5E8BAA" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1"
                                               FontSize="18" FontFamily="Consolas" FontWeight="Bold"
                                               Foreground="#ECF0F1" VerticalAlignment="Center"
                                               Text="{Binding FiducialHcAngle, StringFormat={}{0:F6}°}"/>

                                    <TextBlock Grid.Row="6" Text="Wafer"
                                               Foreground="#5E8BAA" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1"
                                               FontSize="18" FontFamily="Consolas" FontWeight="Bold"
                                               Foreground="#ECF0F1" VerticalAlignment="Center"
                                               Text="{Binding FiducialWaferAngle, StringFormat={}{0:F6}°}"/>
                                </Grid>
                            </Border>

                            <!-- ── STATUS ── -->
                            <Rectangle Height="1" Fill="#1C3A52" Margin="0,16,0,14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="#4A1A1A" CornerRadius="4" Padding="10,4"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="STATUS" Foreground="#E74C3C" FontSize="13" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="System Status"
                                           Foreground="#ECF0F1" FontSize="18" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Mapping Status -->
                            <TextBlock Text="Mapping" Foreground="#F39C12" FontSize="13"
                                       FontWeight="Bold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- P-Table Status -->
                                <Border Grid.Column="0" Padding="10,8" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#060F1A"/>
                                            <Setter Property="BorderBrush" Value="#1C3A52"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Pmac.IsPTableMappingActive}" Value="True">
                                                    <Setter Property="Background" Value="#0A2A1A"/>
                                                    <Setter Property="BorderBrush" Value="#2ECC71"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#5E8BAA"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Pmac.IsPTableMappingActive}" Value="True">
                                                            <Setter Property="Fill" Value="#2ECC71"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="P-Table" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#5E8BAA"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Pmac.IsPTableMappingActive}" Value="True">
                                                            <Setter Property="Foreground" Value="#2ECC71"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- W-Table Status -->
                                <Border Grid.Column="2" Padding="10,8" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#060F1A"/>
                                            <Setter Property="BorderBrush" Value="#1C3A52"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Pmac.IsWTableMappingActive}" Value="True">
                                                    <Setter Property="Background" Value="#0A2A1A"/>
                                                    <Setter Property="BorderBrush" Value="#2ECC71"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#5E8BAA"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Pmac.IsWTableMappingActive}" Value="True">
                                                            <Setter Property="Fill" Value="#2ECC71"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="W-Table" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#5E8BAA"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Pmac.IsWTableMappingActive}" Value="True">
                                                            <Setter Property="Foreground" Value="#2ECC71"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Axis Jitter -->
                            <TextBlock Text="Axis Jitter" Foreground="#F39C12" FontSize="13"
                                       FontWeight="Bold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding JitterAxes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4" Padding="10,6" CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#060F1A"/>
                                                    <Setter Property="BorderBrush" Value="#1C3A52"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsJitterWarning}" Value="True">
                                                            <Setter Property="Background" Value="#1A0A0A"/>
                                                            <Setter Property="BorderBrush" Value="#8C2A2A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#2ECC71"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsJitterWarning}" Value="True">
                                                                    <Setter Property="Fill" Value="#E74C3C"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           Foreground="#5E8BAA" FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="2"
                                                           FontSize="14" FontFamily="Consolas" FontWeight="Bold"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           Margin="0,0,6,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#ECF0F1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsJitterWarning}" Value="True">
                                                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding Jitter, StringFormat={}{0:F5}, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="3" Text="nm"
                                                           Foreground="#5E8BAA" FontSize="11"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

</UserControl>
