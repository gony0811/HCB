<UserControl x:Class="HCB.UI.StepSeqTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
      xmlns:local="clr-namespace:HCB.UI"
      mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SYSTEM/COMMON/Styles/DefaultResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Dark TextBox Style -->
            <Style x:Key="DarkTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#ECF0F1"/>
                <Setter Property="CaretBrush" Value="#ECF0F1"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="StepButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Foreground" Value="#ECF0F1"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="StartButtonStyle" TargetType="Button" BasedOn="{StaticResource StepButtonStyle}">
                <Setter Property="Background" Value="#1A3A5C"/>
                <Setter Property="BorderBrush" Value="#2A5A8C"/>
                <Setter Property="Width" Value="90"/>
            </Style>

            <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource StepButtonStyle}">
                <Setter Property="Background" Value="#4A1A1A"/>
                <Setter Property="BorderBrush" Value="#8C2A2A"/>
                <Setter Property="Width" Value="90"/>
            </Style>

            <Style x:Key="InfoButtonStyle" TargetType="Button" BasedOn="{StaticResource StepButtonStyle}">
                <Setter Property="Background" Value="#1A2A1A"/>
                <Setter Property="BorderBrush" Value="#2A5A2A"/>
                <Setter Property="Width" Value="80"/>
            </Style>

            <Style x:Key="InfoToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Width" Value="80"/>
                <Setter Property="Foreground" Value="#ECF0F1"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="#1A2A1A"
                                    BorderBrush="#2A5A2A" BorderThickness="1" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2A5A2A"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#2ECC71"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Preparation Sequence (코드비하인드에서 주입) -->
        <ContentControl x:Name="PreparationContent" Grid.Row="0"/>

        <!-- ═══════════════════════════════════════════════════════
             ALIGNMENT SEQUENCES : Bottom / Top
             ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="6">
        <Grid local:GridHelper.Columns="1*, 1*">

            <!-- ─── LEFT : BOTTOM ALIGN ─── -->
            <Border Background="#0D1B2A" CornerRadius="8" Margin="6,3,3,6"
                    BorderBrush="#1C3A52" BorderThickness="1" Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="16,14,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#1A3A5C" CornerRadius="4" Padding="10,4"
                                VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="BOTTOM" Foreground="#3498DB" FontSize="13" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Bottom Sequence"
                                   Foreground="#ECF0F1" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                    <Rectangle Grid.Row="0" Height="1" Fill="#1C3A52"
                               VerticalAlignment="Bottom" Margin="16,44,16,0"/>

                    <!-- Steps -->
                    <StackPanel Grid.Row="1" Margin="0,8,0,8">

                        <!-- Step 1 : 저배율 보정 + PICK UP -->
                        <Border Background="#0A1628" CornerRadius="6" Margin="16,6,16,6">
                            <Grid Margin="14,10,14,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1A3A5C" CornerRadius="14"
                                        Width="28" Height="28" Margin="0,0,10,0">
                                    <TextBlock Text="1" Foreground="#3498DB" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <local:StepLamp Grid.Column="1" Style="{StaticResource StepLampStyle}"
                                                State="{Binding BtmLowAlignState}" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="저배율 보정 + PICK UP" Foreground="#ECF0F1" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding BtmLowAlignElapsed}" Foreground="#F39C12" FontSize="13"
                                                   FontFamily="Consolas" Margin="10,2,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Low Calibration &amp; Die Pick Up" Foreground="#5E8BAA" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="3" Style="{StaticResource StartButtonStyle}"
                                        Command="{Binding BtmAlignPickupCommand}">
                                    <TextBlock Text="START" FontSize="13" FontWeight="Bold"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Rectangle Width="2" Height="14" Fill="#1C3A52" HorizontalAlignment="Left" Margin="42,0,0,0"/>

                        <!-- Step 2 : PLACE -->
                        <Border Background="#0A1628" CornerRadius="6" Margin="16,0,16,6">
                            <Grid Margin="14,10,14,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1A3A5C" CornerRadius="14"
                                        Width="28" Height="28" Margin="0,0,10,0">
                                    <TextBlock Text="2" Foreground="#3498DB" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <local:StepLamp Grid.Column="1" Style="{StaticResource StepLampStyle}"
                                                State="{Binding BtmPlaceState}" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="PLACE" Foreground="#ECF0F1" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding BtmPlaceElapsed}" Foreground="#F39C12" FontSize="13"
                                                   FontFamily="Consolas" Margin="10,2,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Die Place on Wafer" Foreground="#5E8BAA" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="3" Style="{StaticResource StartButtonStyle}"
                                        Command="{Binding BtmPlaceCommand}">
                                    <TextBlock Text="START" FontSize="13" FontWeight="Bold"/>
                                </Button>
                            </Grid>
                        </Border>

                    </StackPanel>

                    <!-- Footer -->
                    <Border Grid.Row="2" BorderBrush="#1C3A52" BorderThickness="0,1,0,0"
                            Margin="16,0,16,0" Padding="0,10,0,14">
                        <Grid>
                            <TextBlock Text="{Binding BtmFullElapsed}" Foreground="#F39C12" FontSize="15"
                                       FontFamily="Consolas" FontWeight="Bold"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource StartButtonStyle}" Width="90"
                                        Margin="2"
                                        Command="{Binding BtmFullSequenceCommand}">
                                    <TextBlock Text="START" FontSize="13" FontWeight="Bold"/>
                                </Button>
                                <Button Style="{StaticResource StopButtonStyle}" Width="90"
                                        Margin="2"
                                        Command="{Binding StopCommand}">
                                    <TextBlock Text="STOP" FontSize="13" FontWeight="Bold"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ─── RIGHT : TOP ALIGN ─── -->
            <Border Background="#0D1B2A" CornerRadius="8" Margin="3,3,6,6"
                    BorderBrush="#1C3A52" BorderThickness="1" Grid.Column="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="16,14,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#14452A" CornerRadius="4" Padding="10,4"
                                VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="TOP" Foreground="#2ECC71" FontSize="13" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Top Sequence"
                                   Foreground="#ECF0F1" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>
                    <Rectangle Grid.Row="0" Height="1" Fill="#1C3A52"
                               VerticalAlignment="Bottom" Margin="16,44,16,0"/>

                    <!-- Steps -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8">
                        <StackPanel  Margin="0,8,0,8">

                            <!-- Step 1 : 회전중심·카메라 거리 측정 + 저배율 보정 + PICK UP -->
                            <Border Background="#0A1628" CornerRadius="6" Margin="16,6,16,6">
                                <Grid Margin="14,10,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#14452A" CornerRadius="14"
                                        Width="28" Height="28" Margin="0,0,10,0">
                                        <TextBlock Text="1" Foreground="#2ECC71" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <local:StepLamp Grid.Column="1" Style="{StaticResource StepLampStyle}"
                                                State="{Binding TopLowAlignState}" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="회전중심·카메라 거리 측정 + 저배율 보정 + PICK UP" Foreground="#ECF0F1" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TopLowAlignElapsed}" Foreground="#F39C12" FontSize="13"
                                                       FontFamily="Consolas" Margin="10,2,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="HcRO/Cam Dist Measure &amp; Low Calibration &amp; Die Pick Up" Foreground="#5E8BAA" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Style="{StaticResource StartButtonStyle}"
                                        Command="{Binding TopAlignPickupCommand}">
                                        <TextBlock Text="START" FontSize="13" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <Rectangle Width="2" Height="12" Fill="#1C3A52" HorizontalAlignment="Left" Margin="42,0,0,0"/>

                            <!-- Step 2 : 고배율 보정 (Top die) -->
                            <Border Background="#0A1628" CornerRadius="6" Margin="16,0,16,6">
                                <Grid Margin="14,10,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#14452A" CornerRadius="14"
                                        Width="28" Height="28" Margin="0,0,10,0">
                                        <TextBlock Text="2" Foreground="#2ECC71" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 램프 -->
                                    <local:StepLamp Grid.Column="1" Style="{StaticResource StepLampStyle}"
                                                State="{Binding TopHighAlignState}" Margin="0,0,10,0"/>

                                    <!-- 타이틀 -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="고배율 측정 (Top die)" Foreground="#ECF0F1" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TopHighAlignElapsed}" Foreground="#F39C12" FontSize="13"
                                                       FontFamily="Consolas" Margin="10,2,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="High Magnification Calibration - Top" Foreground="#5E8BAA" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- 진행 표시 (반복 중일 때만 표시) -->
                                    <Border Grid.Column="3"
                                        Background="#0D2335" CornerRadius="6" Padding="12,6"
                                        Margin="0,0,8,0"
                                        Visibility="{Binding IsRepeatRunning, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⟳ " Foreground="#2ECC71" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding RepeatProgressText}"
                                                   Foreground="#ECF0F1" FontSize="13" FontFamily="Consolas"
                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- START 버튼 -->
                                    <Button Grid.Column="4" Style="{StaticResource StartButtonStyle}"
                                        Command="{Binding TopHighAlignCommand}">
                                        <TextBlock Text="START" FontSize="13" FontWeight="Bold"/>
                                    </Button>

                                </Grid>
                            </Border>

                            <Rectangle Width="2" Height="12" Fill="#1C3A52" HorizontalAlignment="Left" Margin="42,0,0,0"/>

                            <!-- Step 3 : 고배율 보정 (Bottom die) -->
                            <Border Background="#0A1628" CornerRadius="6" Margin="16,0,16,6">
                                <Grid Margin="14,10,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#14452A" CornerRadius="14"
                                        Width="28" Height="28" Margin="0,0,10,0">
                                        <TextBlock Text="3" Foreground="#2ECC71" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <local:StepLamp Grid.Column="1" Style="{StaticResource StepLampStyle}"
                                                State="{Binding BtmHighAlignState}" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="고배율 측정 (Bottom die)" Foreground="#ECF0F1" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding BtmHighAlignElapsed}" Foreground="#F39C12" FontSize="13"
                                                       FontFamily="Consolas" Margin="10,2,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="High Magnification Calibration - Bottom" Foreground="#5E8BAA" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Style="{StaticResource StartButtonStyle}"
                                        Command="{Binding BtmHighAlignCommand}">
                                        <TextBlock Text="START" FontSize="13" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <Rectangle Width="2" Height="12" Fill="#1C3A52" HorizontalAlignment="Left" Margin="42,0,0,0"/>

                            <!-- Step 4 : 보정 (Correction) -->
                            <Border Background="#0A1628" CornerRadius="6" Margin="16,0,16,6">
                                <Grid Margin="14,10,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#14452A" CornerRadius="14"
                                            Width="28" Height="28" Margin="0,0,10,0">
                                        <TextBlock Text="4" Foreground="#2ECC71" FontSize="13" FontWeight="Bold"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <local:StepLamp Grid.Column="1" Style="{StaticResource StepLampStyle}"
                                                    State="{Binding TopCorrState}" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="보정" Foreground="#ECF0F1" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TopCorrElapsed}" Foreground="#F39C12" FontSize="13"
                                                       FontFamily="Consolas" Margin="10,2,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Alignment Correction" Foreground="#5E8BAA" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Style="{StaticResource InfoButtonStyle}" Margin="0,0,6,0"
                                            Command="{Binding OpenTopHighAlignInfoCommand}">
                                        <TextBlock Text="INFO" FontSize="12" FontWeight="Bold"/>
                                    </Button>
                                    <Button Grid.Column="4" Style="{StaticResource StartButtonStyle}"
                                            Command="{Binding TopCorrCommand}">
                                        <TextBlock Text="START" FontSize="13" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <Rectangle Width="2" Height="12" Fill="#1C3A52" HorizontalAlignment="Left" Margin="42,0,0,0"/>

                            <!-- Step 5 : BONDING -->
                            <Border Background="#0A1628" CornerRadius="6" Margin="16,0,16,6">
                                <Grid Margin="14,10,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#14452A" CornerRadius="14"
                                        Width="28" Height="28" Margin="0,0,10,0">
                                        <TextBlock Text="5" Foreground="#2ECC71" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <local:StepLamp Grid.Column="1" Style="{StaticResource StepLampStyle}"
                                                State="{Binding TopBondingState}" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="BONDING" Foreground="#ECF0F1" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TopBondingElapsed}" Foreground="#F39C12" FontSize="13"
                                                       FontFamily="Consolas" Margin="10,2,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Hybrid Bonding" Foreground="#5E8BAA" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="3" Style="{StaticResource InfoButtonStyle}" Margin="0,0,6,0"
                                        Command="{Binding TopHighAlignInfoCommand}">
                                        <TextBlock Text="INFO" FontSize="12" FontWeight="Bold"/>
                                    </Button>
                                    <Button Grid.Column="4" Style="{StaticResource InfoButtonStyle}" Margin="0,0,6,0"
                                            Command="{Binding NoVacOffBondingCommand}">
                                        <TextBlock Text="TEST" FontSize="12" FontWeight="Bold"/>
                                    </Button>
                                    <Button Grid.Column="5" Style="{StaticResource StartButtonStyle}"
                                        Command="{Binding TopBondingCommand}">
                                        <TextBlock Text="START" FontSize="13" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                    <!-- Footer -->
                    <Border Grid.Row="2" BorderBrush="#1C3A52" BorderThickness="0,1,0,0"
                            Margin="16,0,16,0" Padding="0,10,0,14">
                        
                        <Grid>
                            <!-- Vernier 결과 DataGrid -->
                            <!-- Border Background="#060F1A" CornerRadius="6" Margin="0,0,8,0"
                                    BorderBrush="#1C3A52" BorderThickness="1" VerticalAlignment="Center">
                                <DataGrid ItemsSource="{Binding VernierRows}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          Background="Transparent" BorderThickness="0"
                                          RowBackground="Transparent"
                                          AlternatingRowBackground="#0A1628"
                                          Foreground="#ECF0F1" FontSize="11" FontFamily="Consolas"
                                          CanUserResizeRows="False" CanUserAddRows="False"
                                          GridLinesVisibility="None" RowHeaderWidth="0"
                                          ColumnHeaderHeight="22" RowHeight="20"
                                          MaxHeight="140">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="Background" Value="#0A1628"/>
                                            <Setter Property="Foreground" Value="#2ECC71"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#1C3A52"/>
                                            <Setter Property="Padding" Value="6,2"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell"
                                               BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="6,1"/>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Pos" Binding="{Binding Name}"                      Width="32"/>
                                        <DataGridTextColumn Header="V1-X" Binding="{Binding V1X, StringFormat={}{0:F3}}" Width="60"/>
                                        <DataGridTextColumn Header="V1-Y" Binding="{Binding V1Y, StringFormat={}{0:F3}}" Width="60"/>
