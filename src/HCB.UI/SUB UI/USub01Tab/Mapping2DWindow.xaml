<telerik:RadWindow x:Class="HCB.UI.Mapping2DWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
                   xmlns:local="clr-namespace:HCB.UI"
                   Style="{StaticResource RadWindowStyle}"
                   Header="2D Mapping"
                   WindowStartupLocation="CenterScreen"
                   Width="460" Height="760">

    <telerik:RadWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SYSTEM/COMMON/Styles/DefaultResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- 실행 버튼 -->
            <Style x:Key="CalibBtnStyle" TargetType="Button">
                <Setter Property="Background" Value="#1A3A5C"/>
                <Setter Property="Foreground" Value="#ECF0F1"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderBrush" Value="#2A5A8C"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="52"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#234E7A"/>
                                    <Setter Property="BorderBrush" Value="#3498DB"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#0F2A45"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- CalibComboStyle -->
            <Style x:Key="CalibComboStyle" TargetType="ComboBox">
                <Setter Property="Foreground" Value="#ECF0F1"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  Focusable="False" ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="#0A1628" BorderBrush="#2A5A8C"
                                        BorderThickness="1" CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="32"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="#5E8BAA" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Margin="10,0,32,0"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                           Focusable="False" AllowsTransparency="True">
                                    <Border Background="#0A1628" BorderBrush="#2A5A8C"
                                BorderThickness="1" CornerRadius="4"
                                MaxHeight="300" MinWidth="{TemplateBinding ActualWidth}">
                                        <ScrollViewer>
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="#ECF0F1"/>
                            <Setter Property="Background" Value="#0A1628"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter Property="Background" Value="#1A3A5C"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#234E7A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CalibTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#0A1628"/>
                <Setter Property="Foreground" Value="#ECF0F1"/>
                <Setter Property="CaretBrush" Value="#ECF0F1"/>
                <Setter Property="BorderBrush" Value="#2A5A8C"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Right"/>
            </Style>

            <!-- 타입 선택 토글 (Grid / Wafer) -->
            <Style x:Key="TypeToggleStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#8FB0C8"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="#0A1628" BorderBrush="#2A5A8C"
                                    BorderThickness="1" CornerRadius="6" Height="40">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3498DB"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#234E7A"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3498DB"/>
                                    <Setter Property="Foreground" Value="#ECF0F1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </telerik:RadWindow.Resources>

    <Border Background="#0D1B2A">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 타입 선택 (Grid / Wafer) -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="GridTypeButton" GroupName="MappingType"
                             Style="{StaticResource TypeToggleStyle}"
                             Content="Grid" IsChecked="True"
                             Checked="MappingType_Checked"/>
                <RadioButton x:Name="WaferTypeButton" Grid.Column="2" GroupName="MappingType"
                             Style="{StaticResource TypeToggleStyle}"
                             Content="Wafer"
                             Checked="MappingType_Checked"/>
            </Grid>

            <Rectangle Grid.Row="1" Height="1" Fill="#1C3A52" Margin="0,0,0,14"/>

            <!-- ══════════════════════════════════════════════
                 Grid 타입 : 기존 2D Mapping 기능 (그대로)
            ══════════════════════════════════════════════ -->
            <ScrollViewer x:Name="GridPanel" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Grid 2D Mapping" Foreground="#5E8BAA"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Foreground="#3D5A72" FontSize="12" TextWrapping="Wrap"
                               Margin="0,0,0,12">
                        MasterGlass 원점(0,0)에서 시작하여 N×N 그리드를 지정 간격으로 측정합니다.
                        결과는 Desktop/HCB/2D Mapping 에 CSV로 저장됩니다.
                    </TextBlock>

                    <!-- 카메라 선택 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="카메라" Foreground="#5E8BAA" FontSize="16"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource CalibComboStyle}"
                                  ItemsSource="{Binding Source={local:EnumValues {x:Type local:CameraType}}}"
                                  SelectedItem="{Binding MappingCamera}"/>
                    </Grid>

                    <!-- 마크 선택 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="마크" Foreground="#5E8BAA" FontSize="16"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource CalibComboStyle}"
                                  ItemsSource="{Binding Source={local:EnumValues {x:Type local:MarkType}}}"
                                  SelectedItem="{Binding MappingMark}"/>
                    </Grid>

                    <!-- 방향 선택 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="방향" Foreground="#5E8BAA" FontSize="16"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource CalibComboStyle}"
                                  ItemsSource="{Binding Source={local:EnumValues {x:Type local:DirectType}}}"
                                  SelectedItem="{Binding MappingDirect}"/>
                    </Grid>

                    <!-- Step / Grid 설정 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="이동 간격" Foreground="#5E8BAA" FontSize="16"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{StaticResource CalibTextBoxStyle}"
                                 Text="{Binding MappingStepMm, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Grid.Column="2" Text="mm" Foreground="#5E8BAA" FontSize="16"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="그리드" Foreground="#5E8BAA" FontSize="16"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{StaticResource CalibTextBoxStyle}"
                                 Text="{Binding MappingGridSize, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Grid.Column="2" Text="×N" Foreground="#5E8BAA" FontSize="16"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- 실행 버튼 -->
                    <Button Style="{StaticResource CalibBtnStyle}"
                            Content="2D Mapping 실행"
                            Command="{Binding RunMapping2DCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Margin="0,0,0,10"/>

                    <!-- 진행률 -->
                    <Border Background="#0A1628" BorderBrush="#2A5A8C" BorderThickness="1"
                            CornerRadius="6" Padding="10,8">
                        <TextBlock Text="{Binding MappingProgress}"
                                   Foreground="#E67E22" FontSize="14" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════════════════════
                 Wafer 타입 : 웨이퍼 맵 기반 측정 포인트
                   좌 2/3 = 웨이퍼 맵, 우 1/3 = 설정
            ══════════════════════════════════════════════ -->
            <Grid x:Name="WaferPanel" Grid.Row="2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ── 웨이퍼 맵 (2/3) ── -->
                <Grid Grid.Column="0">
                    <Border Background="#0A1628" BorderBrush="#2A5A8C"
                            BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <Canvas x:Name="WaferCanvas" Background="Transparent"
                                SizeChanged="WaferCanvas_SizeChanged"
                                MouseLeftButtonDown="WaferCanvas_Click"/>
                    </Border>

                    <!-- 셀 클릭 → 고배 좌표 확인·이동 패널 -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="10"
                            Background="#0D1B2A" BorderBrush="#3498DB" BorderThickness="1"
                            CornerRadius="6" Padding="14,10"
                            Visibility="{Binding HasSelectedCell, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Foreground="#ECF0F1" FontSize="14" FontWeight="SemiBold"
                                       Text="{Binding SelectedCellInfo, StringFormat=선택 Cell — {0}}"/>
                            <TextBlock Foreground="#8FB0C8" FontSize="13" Margin="0,4,0,0">
                                <Run Text="고배 좌표  X="/><Run Text="{Binding SelectedCellHighX, StringFormat=F4}" Foreground="#2ECC71"/>
                                <Run Text="   Y="/><Run Text="{Binding SelectedCellHighY, StringFormat=F4}" Foreground="#2ECC71"/>
                                <Run Text=" mm"/>
                            </TextBlock>
                            <TextBlock Text="이 위치로 이동하시겠습니까?" Foreground="#E67E22"
                                       FontSize="13" Margin="0,6,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="이동" Width="90"
                                        Style="{StaticResource CalibBtnStyle}"
                                        Command="{Binding MoveToCellCommand}"
                                        IsEnabled="{Binding IsNotBusy}" Margin="0,0,8,0"/>
                                <Button Content="취소" Width="90" Height="52" FontSize="16" Cursor="Hand"
                                        Foreground="#ECF0F1" Command="{Binding CancelMoveToCellCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="#3A4652" BorderBrush="#5E6B78"
                                                    BorderThickness="1" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── 설정 (1/3) ── -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Wafer 생성" Foreground="#5E8BAA"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Foreground="#3D5A72" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,0,0,12">
                            도면 사양(행별 개수)대로 그리드를 배열합니다. 각 행은 수평 중앙 정렬됩니다.
                            그리드(셀)만 그립니다.
                        </TextBlock>

                        <!-- 행별 개수 (위→아래, 쉼표 구분) -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="행별 개수 (위→아래)" Foreground="#5E8BAA" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="도면값" FontSize="12" Foreground="#8FB0C8"
                                    Background="Transparent" BorderBrush="#2A5A8C" BorderThickness="1"
                                    Padding="8,2" Cursor="Hand"
                                    Command="{Binding LoadDrawingRowCountsCommand}"/>
                        </Grid>
                        <TextBox Style="{StaticResource CalibTextBoxStyle}" Height="Auto" MinHeight="60"
                                 TextAlignment="Left" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" Margin="0,0,0,10"
                                 Text="{Binding WaferRowCounts, UpdateSourceTrigger=LostFocus}"/>

                        <!-- 그리드 사이즈 -->
                        <TextBlock Text="그리드 사이즈" Foreground="#5E8BAA" FontSize="14" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource CalibTextBoxStyle}"
                                     Text="{Binding WaferCellSize, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Column="1" Text="mm" Foreground="#5E8BAA" FontSize="14"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- 그리드 간격 (Gap) -->
                        <TextBlock Text="그리드 간격 (Gap)" Foreground="#5E8BAA" FontSize="14" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource CalibTextBoxStyle}"
                                     Text="{Binding WaferCellGap, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Column="1" Text="mm" Foreground="#5E8BAA" FontSize="14"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- 마크 피치 -->
                        <TextBlock Text="마크 피치" Foreground="#5E8BAA" FontSize="14" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource CalibTextBoxStyle}"
                                     Text="{Binding WaferMarkPitch, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Column="1" Text="mm" Foreground="#5E8BAA" FontSize="14"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- 생성 버튼 -->
                        <Button Style="{StaticResource CalibBtnStyle}"
                                Content="Wafer 생성"
                                Command="{Binding GenerateWaferMapCommand}"
                                Margin="0,0,0,10"/>

                        <!-- 결과 요약 -->
                        <Border Background="#0A1628" BorderBrush="#2A5A8C" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="셀" Foreground="#5E8BAA" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WaferCellCount}"
                                               Foreground="#2ECC71" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="측정 포인트" Foreground="#5E8BAA" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WaferMarkCount}"
                                               Foreground="#E67E22" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#0A1628" BorderBrush="#2A5A8C" BorderThickness="1"
                                CornerRadius="6" Padding="10,8">
                            <TextBlock Text="{Binding WaferMapStatus}"
                                       Foreground="#E67E22" FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                        <!-- ── 센터·Theta 찾기/보정 ── -->
                        <Rectangle Height="1" Fill="#1C3A52" Margin="0,16,0,12"/>
                        <TextBlock Text="센터 · Theta" Foreground="#5E8BAA"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Foreground="#3D5A72" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10">
                            ① Edge 3점(WAFER_ALIGN_1/2/3)으로 센터 찾기 → ② 센터 이동·고배 전환
                            → ③ 좌우 대칭 쌍으로 θ 측정·W_T 보정.
                        </TextBlock>

                        <Button Style="{StaticResource CalibBtnStyle}"
                                Content="센터 찾기 (Edge 3점)"
                                Command="{Binding FindWaferCenterCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Margin="0,0,0,8"/>

                        <Button Style="{StaticResource CalibBtnStyle}"
                                Content="전체 시퀀스 (센터→고배→Theta)"
                                Command="{Binding RunWaferSequenceCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Margin="0,0,0,10"/>

                        <Border Background="#0A1628" BorderBrush="#2A5A8C" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="센터 X" Foreground="#5E8BAA" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WaferFoundCenterX, StringFormat=F4}"
                                               Foreground="#ECF0F1" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="센터 Y" Foreground="#5E8BAA" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WaferFoundCenterY, StringFormat=F4}"
                                               Foreground="#ECF0F1" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Theta (°)" Foreground="#5E8BAA" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WaferFoundThetaDeg, StringFormat=F4}"
                                               Foreground="#2ECC71" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#0A1628" BorderBrush="#2A5A8C" BorderThickness="1"
                                CornerRadius="6" Padding="10,8">
                            <TextBlock Text="{Binding WaferCenterStatus}"
                                       Foreground="#3498DB" FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                        <!-- ── 전수 순회 측정 ── -->
                        <Rectangle Height="1" Fill="#1C3A52" Margin="0,16,0,12"/>
                        <TextBlock Text="전수 측정 (Cell 순회)" Foreground="#5E8BAA"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Foreground="#3D5A72" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10">
                            유효 영역 내 모든 Cell을 순회하며 Cell당 대표 Mark 1개를 측정합니다.
                            결과는 Desktop/HCB/2D Mapping 에 CSV로 저장됩니다.
                        </TextBlock>

                        <!-- 상태 범례 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Rectangle Width="12" Height="12" Fill="#992ECC71" VerticalAlignment="Center"/>
                            <TextBlock Text="완료" Foreground="#8FB0C8" FontSize="12" Margin="4,0,10,0" VerticalAlignment="Center"/>
                            <Rectangle Width="12" Height="12" Fill="#AAE67E22" VerticalAlignment="Center"/>
                            <TextBlock Text="측정중" Foreground="#8FB0C8" FontSize="12" Margin="4,0,10,0" VerticalAlignment="Center"/>
                            <Rectangle Width="12" Height="12" Stroke="#5E8BAA" StrokeThickness="1" Fill="Transparent" VerticalAlignment="Center"/>
                            <TextBlock Text="미측정" Foreground="#8FB0C8" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Style="{StaticResource CalibBtnStyle}"
                                Content="전수 측정 실행"
                                Command="{Binding MappingMeasurementCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Margin="0,0,0,10"/>

                        <Border Background="#0A1628" BorderBrush="#2A5A8C" BorderThickness="1"
                                CornerRadius="6" Padding="10,8">
                            <TextBlock Text="{Binding TraversalProgress}"
                                       Foreground="#E67E22" FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</telerik:RadWindow>
