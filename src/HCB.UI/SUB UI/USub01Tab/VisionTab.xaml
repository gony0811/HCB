<UserControl x:Class="HCB.UI.VisionTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:local="clr-namespace:HCB.UI"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SYSTEM/COMMON/Styles/DefaultResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- 버튼 스타일 -->
            <Style x:Key="VisionBtnStyle" TargetType="Button">
                <Setter Property="Background" Value="#1A3A5C"/>
                <Setter Property="Foreground" Value="#ECF0F1"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderBrush" Value="#2A5A8C"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="48"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#234E7A"/>
                                    <Setter Property="BorderBrush" Value="#3498DB"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#0F2A45"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 콤보박스 스타일 -->
            <Style x:Key="VisionComboStyle" TargetType="ComboBox">
                <Setter Property="Foreground" Value="#ECF0F1"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                    Focusable="False" ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="#0A1628" BorderBrush="#2A5A8C"
                                                    BorderThickness="1" CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="32"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                                                          Fill="#5E8BAA" HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Margin="10,0,32,0"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                       Focusable="False" AllowsTransparency="True">
                                    <Border Background="#0A1628" BorderBrush="#2A5A8C"
                                            BorderThickness="1" CornerRadius="4"
                                            MaxHeight="300" MinWidth="{TemplateBinding ActualWidth}">
                                        <ScrollViewer>
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="#ECF0F1"/>
                            <Setter Property="Background" Value="#0A1628"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter Property="Background" Value="#1A3A5C"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#234E7A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 값 표시 스타일 -->
            <Style x:Key="ValueLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#5E8BAA"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ValueTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#ECF0F1"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </Style>

            <!-- Z트래킹 입력 스타일 -->
            <Style x:Key="ZTrackInputStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#0A1628"/>
                <Setter Property="Foreground" Value="#ECF0F1"/>
                <Setter Property="BorderBrush" Value="#2A5A8C"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </Style>
            <Style x:Key="ZTrackLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#5E8BAA"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="6">
        <Border Background="#0D1B2A" CornerRadius="8"
                BorderBrush="#1C3A52" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <local:HeaderBar Margin="12,10,12,0" Title="VISION"/>
                <Rectangle Grid.Row="0" Height="1" Fill="#1C3A52"
                           VerticalAlignment="Bottom" Margin="12,32,12,0"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Margin="0,8,0,0">
                    <StackPanel Margin="0,0,0,12">

                        <!-- ═══ 설정 ═══ -->
                        <TextBlock Text="카메라 / 마크 선택" Foreground="#5E8BAA"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="16,8,16,6"/>

                        <ComboBox Style="{StaticResource VisionComboStyle}" Margin="16,0,16,6"
                                  ItemsSource="{Binding Source={local:EnumValues {x:Type local:CameraType}}}"
                                  SelectedItem="{Binding SelectedCamera}"/>
                        <ComboBox Style="{StaticResource VisionComboStyle}" Margin="16,0,16,6"
                                  ItemsSource="{Binding Source={local:EnumValues {x:Type local:MarkType}}}"
                                  SelectedItem="{Binding SelectedMark}"/>
                        <ComboBox Style="{StaticResource VisionComboStyle}" Margin="16,0,16,12"
                                  ItemsSource="{Binding Source={local:EnumValues {x:Type local:DirectType}}}"
                                  SelectedItem="{Binding SelectedDirect}"/>

                        <!-- ═══ 모션 정보 (실시간) ═══ -->
                        <TextBlock Text="모션 정보 (실시간)" Foreground="#5E8BAA"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="16,4,16,6"/>
                        <Border Background="#0A1628" BorderBrush="#1C3A52" BorderThickness="1"
                                CornerRadius="6" Margin="16,0,16,8" Padding="14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ValueLabelStyle}" Text="H_X"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}"
                                           Text="{Binding HxAxis.CurrentPosition, StringFormat='{}{0:F4} mm'}" Margin="12,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ValueLabelStyle}"
                                           Text="{Binding MotionYName}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}"
                                           Text="{Binding MotionYAxis.CurrentPosition, StringFormat='{}{0:F4} mm'}" Margin="12,2"/>
                            </Grid>
                        </Border>

                        <Rectangle Height="1" Fill="#1C3A52" Margin="16,4"/>

                        <!-- ═══ 1단계: 측정 ═══ -->
                        <TextBlock Text="1. 비전 측정" Foreground="#3498DB"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="16,12,16,6"/>
                        <TextBlock Foreground="#3D5A72" FontSize="12" TextWrapping="Wrap"
                                   Margin="16,0,16,8">
                            현재 위치에서 비전 측정만 수행합니다. 결과를 확인한 후 이동 버튼을 누르세요.
                        </TextBlock>

                        <Button Style="{StaticResource VisionBtnStyle}"
                                Content="측정"
                                Command="{Binding MeasureCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Margin="16,0,16,8"/>

                        <!-- 측정 결과 표시 -->
                        <Border Background="#0A1628" BorderBrush="#1C3A52" BorderThickness="1"
                                CornerRadius="6" Margin="16,0,16,8" Padding="14,8"
                                Visibility="{Binding HasMeasurement, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ValueLabelStyle}" Text="X"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}"
                                           Text="{Binding MeasuredX, StringFormat='{}{0:F6} mm'}" Margin="12,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ValueTextStyle}"
                                           Foreground="#E67E22"
                                           Text="{Binding MeasuredXUm, StringFormat='({0:+0.0;-0.0;0.0} um)'}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ValueLabelStyle}" Text="Y"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}"
                                           Text="{Binding MeasuredY, StringFormat='{}{0:F6} mm'}" Margin="12,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueTextStyle}"
                                           Foreground="#E67E22"
                                           Text="{Binding MeasuredYUm, StringFormat='({0:+0.0;-0.0;0.0} um)'}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ValueLabelStyle}" Text="Dist"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}"
                                           Text="{Binding MeasuredDist, StringFormat='{}{0:F6} mm'}" Margin="12,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueTextStyle}"
                                           Foreground="#E67E22"
                                           Text="{Binding MeasuredDistUm, StringFormat='({0:+0.0;-0.0;0.0} um)'}"/>
                            </Grid>
                        </Border>

                        <!-- 측정 시점 모션 스냅샷 -->
                        <Border Background="#0A1628" BorderBrush="#1C3A52" BorderThickness="1"
                                CornerRadius="6" Margin="16,0,16,8" Padding="14,8"
                                Visibility="{Binding HasMotionSnapshot, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ValueLabelStyle}" Text="측정 H_X"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}"
                                           Foreground="#5DADE2"
                                           Text="{Binding MotionHx, StringFormat='{}{0:F4} mm'}" Margin="12,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ValueLabelStyle}"
                                           Text="{Binding MotionYName, StringFormat='측정 {0}'}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}"
                                           Foreground="#5DADE2"
                                           Text="{Binding MotionY, StringFormat='{}{0:F4} mm'}" Margin="12,2"/>
                            </Grid>
                        </Border>

                        <Rectangle Height="1" Fill="#1C3A52" Margin="16,4"/>

                        <!-- ═══ 2단계: 이동 ═══ -->
                        <TextBlock Text="2. 보정 이동" Foreground="#2ECC71"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="16,12,16,6"/>
                        <TextBlock Foreground="#3D5A72" FontSize="12" TextWrapping="Wrap"
                                   Margin="16,0,16,8">
                            측정값을 기반으로 마크 중심으로 이동합니다.
                        </TextBlock>

                        <!-- 이동량 표시 -->
                        <Border Background="#0A1628" BorderBrush="#1C3A52" BorderThickness="1"
                                CornerRadius="6" Margin="16,0,16,8" Padding="14,8"
                                Visibility="{Binding HasMeasurement, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ValueLabelStyle}" Text="Move X"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}"
                                           Foreground="#2ECC71"
                                           Text="{Binding MoveX, StringFormat='{}{0:F6} mm'}" Margin="12,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ValueLabelStyle}" Text="Move Y"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}"
                                           Foreground="#2ECC71"
                                           Text="{Binding MoveY, StringFormat='{}{0:F6} mm'}" Margin="12,2"/>
                            </Grid>
                        </Border>

                        <Button Style="{StaticResource VisionBtnStyle}"
                                Content="이동"
                                Command="{Binding MoveToMarkCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Background="#1A4A3C" BorderBrush="#2A8A5C"
                                Margin="16,0,16,8"/>

                        <Rectangle Height="1" Fill="#1C3A52" Margin="16,4"/>

                        <!-- ═══ 3단계: 재측정 ═══ -->
                        <TextBlock Text="3. 재측정 (잔차 확인)" Foreground="#E67E22"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="16,12,16,6"/>
                        <TextBlock Foreground="#3D5A72" FontSize="12" TextWrapping="Wrap"
                                   Margin="16,0,16,8">
                            이동 후 재측정하여 잔차를 확인합니다. CSV에 자동 저장됩니다.
                        </TextBlock>

                        <Button Style="{StaticResource VisionBtnStyle}"
                                Content="재측정"
                                Command="{Binding VerifyCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Background="#4A3A1A" BorderBrush="#8A6A2A"
                                Margin="16,0,16,8"/>

                        <!-- 잔차 결과 표시 -->
                        <Border Background="#0A1628" BorderBrush="#2A5A8C" BorderThickness="1"
                                CornerRadius="6" Margin="16,0,16,8" Padding="14,8"
                                Visibility="{Binding HasVerification, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ValueLabelStyle}" Text="Error X"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}"
                                           Text="{Binding ErrorX, StringFormat='{}{0:F6} mm'}" Margin="12,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ValueTextStyle}"
                                           Foreground="#E74C3C"
                                           Text="{Binding ErrorXUm, StringFormat='({0:+0.0;-0.0;0.0} um)'}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ValueLabelStyle}" Text="Error Y"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}"
                                           Text="{Binding ErrorY, StringFormat='{}{0:F6} mm'}" Margin="12,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueTextStyle}"
                                           Foreground="#E74C3C"
                                           Text="{Binding ErrorYUm, StringFormat='({0:+0.0;-0.0;0.0} um)'}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ValueLabelStyle}" Text="Dist"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}"
                                           Text="{Binding ErrorDist, StringFormat='{}{0:F6} mm'}" Margin="12,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueTextStyle}"
                                           Foreground="#E74C3C"
                                           Text="{Binding ErrorDistUm, StringFormat='({0:+0.0;-0.0;0.0} um)'}"/>
                            </Grid>
                        </Border>

                        <Rectangle Height="1" Fill="#1C3A52" Margin="16,8"/>

                        <!-- 결과 요약 -->
                        <Border Background="#0A1628" BorderBrush="#2A5A8C" BorderThickness="1"
                                CornerRadius="6" Margin="16,4,16,8" Padding="14,10">
                            <TextBlock Text="{Binding ResultSummary}"
                                       Foreground="#E67E22" FontSize="14"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <Rectangle Height="1" Fill="#1C3A52" Margin="16,8"/>

                        <!-- ═══ Bonding ═══ -->
                        <TextBlock Text="Bonding (가압)" Foreground="#E74C3C"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="16,4,16,6"/>
                        <TextBlock Foreground="#3D5A72" FontSize="12" TextWrapping="Wrap"
                                   Margin="16,0,16,8">
                            현재 위치에서 본딩(가압) 시퀀스를 실행합니다.
                        </TextBlock>
                        <Button Style="{StaticResource VisionBtnStyle}"
                                Content="Bonding"
                                Command="{Binding BondingCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Background="#5A1A1A" BorderBrush="#8A2A2A"
                                Margin="16,0,16,8"/>

                        <Rectangle Height="1" Fill="#1C3A52" Margin="16,8"/>

                        <!-- ═══ 전체 시퀀스 ═══ -->
                        <TextBlock Text="전체 시퀀스 (Pickup → PC측정 → 본딩 → HC1측정)" Foreground="#1ABC9C"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="16,4,16,4"/>
                        <TextBlock Foreground="#3D5A72" FontSize="12" TextWrapping="Wrap"
                                   Margin="16,0,16,8">
                            ① Top Die Pickup → ② P-Table 이동 → ③ H_T 회전 → ④ PC로 Top Align 측정(L/R)
                            → ⑤ W-Table(PLACE_CENTER) → ⑥ 본딩 → ⑦ HC1으로 Top Align 측정(L→R) → ⑧ CSV 저장.
                            아래 값은 모두 사용자가 지정합니다 (mm, 축 단위).
                        </TextBlock>

                        <Border Background="#0A1628" BorderBrush="#1C3A52" BorderThickness="1"
                                CornerRadius="6" Margin="16,0,16,8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Top Die / H_T 회전 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ZTrackLabelStyle}" Text="① Top Die"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource ZTrackInputStyle}"
                                           Text="{Binding SeqTopDie, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource ZTrackLabelStyle}" Text="③ H_T 회전"/>
                                <TextBox   Grid.Row="0" Grid.Column="4" Style="{StaticResource ZTrackInputStyle}"
                                           Text="{Binding SeqHtRotation, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Row 2: PC Left H_X / P_Y -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ZTrackLabelStyle}" Text="④ PC-L H_X"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource ZTrackInputStyle}"
                                           Text="{Binding SeqPcLeftHx, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource ZTrackLabelStyle}" Text="④ PC-L P_Y"/>
                                <TextBox   Grid.Row="2" Grid.Column="4" Style="{StaticResource ZTrackInputStyle}"
                                           Text="{Binding SeqPcLeftPy, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Row 4: PC Right H_X / P_Y -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource ZTrackLabelStyle}" Text="④ PC-R H_X"/>
                                <TextBox   Grid.Row="4" Grid.Column="1" Style="{StaticResource ZTrackInputStyle}"
                                           Text="{Binding SeqPcRightHx, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource ZTrackLabelStyle}" Text="④ PC-R P_Y"/>
                                <TextBox   Grid.Row="4" Grid.Column="4" Style="{StaticResource ZTrackInputStyle}"
                                           Text="{Binding SeqPcRightPy, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Row 6: HC1 Left→Right ΔH_X / ΔW_Y -->
                                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource ZTrackLabelStyle}" Text="⑦ HC1 ΔH_X"/>
                                <TextBox   Grid.Row="6" Grid.Column="1" Style="{StaticResource ZTrackInputStyle}"
                                           Text="{Binding SeqHc1DeltaHx, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="6" Grid.Column="3" Style="{StaticResource ZTrackLabelStyle}" Text="⑦ HC1 ΔW_Y"/>
                                <TextBox   Grid.Row="6" Grid.Column="4" Style="{StaticResource ZTrackInputStyle}"
                                           Text="{Binding SeqHc1DeltaWy, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Row 8: 안내 -->
                                <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="5"
                                           Foreground="#3D5A72" FontSize="11" TextWrapping="Wrap"
                                           Text="⑦ HC1은 현재(PLACE_CENTER) 위치에서 Left를 측정한 뒤, ΔH_X·ΔW_Y 만큼 상대 이동해 Right를 측정합니다."/>
                            </Grid>
                        </Border>

                        <!-- 실행 버튼 -->
                        <Button Style="{StaticResource VisionBtnStyle}"
                                Content="전체 시퀀스 실행"
                                Command="{Binding RunFullSequenceCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Background="#0E4D3C" BorderBrush="#1ABC9C"
                                Margin="16,0,16,8"/>

                        <!-- 진행 상태 -->
                        <Border Background="#0A1628" BorderBrush="#1C3A52" BorderThickness="1"
                                CornerRadius="6" Margin="16,0,16,8" Padding="14,8">
                            <TextBlock Text="{Binding SeqStatus}"
                                       Foreground="#1ABC9C" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- 결과 테이블 -->
                        <telerik:RadGridView ItemsSource="{Binding SeqResults}"
                                             AutoGenerateColumns="False"
                                             IsReadOnly="True"
                                             ShowGroupPanel="False"
                                             RowIndicatorVisibility="Collapsed"
                                             CanUserFreezeColumns="False"
                                             Margin="16,0,16,12"
                                             MaxHeight="260"
                                             FontSize="12"
                                             FontFamily="Consolas">
                            <telerik:RadGridView.Columns>
                                <telerik:GridViewDataColumn Header="Step" DataMemberBinding="{Binding Step}" Width="80"/>
                                <telerik:GridViewDataColumn Header="Camera" DataMemberBinding="{Binding Camera}" Width="90"/>
                                <telerik:GridViewDataColumn Header="Dir" DataMemberBinding="{Binding Direction}" Width="70"/>
                                <telerik:GridViewDataColumn Header="H_T" DataMemberBinding="{Binding HtRotation, StringFormat=F4}" Width="80"/>
                                <telerik:GridViewDataColumn Header="H_X" DataMemberBinding="{Binding Hx, StringFormat=F4}" Width="90"/>
                                <telerik:GridViewDataColumn Header="Y축" DataMemberBinding="{Binding YAxisName}" Width="60"/>
                                <telerik:GridViewDataColumn Header="Y" DataMemberBinding="{Binding Y, StringFormat=F4}" Width="90"/>
                                <telerik:GridViewDataColumn Header="Vis X (um)" DataMemberBinding="{Binding VisionXUm, StringFormat=F2}" Width="90"/>
                                <telerik:GridViewDataColumn Header="Vis Y (um)" DataMemberBinding="{Binding VisionYUm, StringFormat=F2}" Width="90"/>
                                <telerik:GridViewDataColumn Header="Result" DataMemberBinding="{Binding Result}" Width="70"/>
                            </telerik:RadGridView.Columns>
                        </telerik:RadGridView>

                        <Rectangle Height="1" Fill="#1C3A52" Margin="16,8"/>

                        <!-- ═══ 4. Z축 피듀셜 트래킹 ═══ -->
                        <TextBlock Text="4. Z축 피듀셜 트래킹 (A/B 반복)" Foreground="#9B59B6"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="16,12,16,4"/>
                        <TextBlock Foreground="#3D5A72" FontSize="12" TextWrapping="Wrap"
                                   Margin="16,0,16,10">
                            A/B 두 Z 위치를 오가며 HC1/HC2 Fiducial 변화량을 반복 측정합니다.
                            먼저 Z축을 원하는 위치로 이동한 후 [A 설정] / [B 설정] 버튼으로 좌표를 지정하세요.
                        </TextBlock>

                        <!-- A/B 지점 설정 -->
                        <Border Background="#0A1628" BorderBrush="#1C3A52" BorderThickness="1"
                                CornerRadius="6" Margin="16,0,16,8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- A 지점 -->
                                <Button Grid.Row="0" Grid.Column="0"
                                        Style="{StaticResource VisionBtnStyle}"
                                        Content="A 설정" Width="80" Height="32"
                                        Command="{Binding SetPositionACommand}"
                                        IsEnabled="{Binding IsNotBusy}"
                                        Background="#1A3A5C" BorderBrush="#2A5A8C"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Style="{StaticResource ZTrackInputStyle}"
                                         Text="{Binding ZPositionA, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="8,0,0,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Style="{StaticResource ZTrackLabelStyle}" Text="mm"
                                           Margin="6,0,0,0"/>

                                <!-- B 지점 -->
                                <Button Grid.Row="2" Grid.Column="0"
                                        Style="{StaticResource VisionBtnStyle}"
                                        Content="B 설정" Width="80" Height="32"
                                        Command="{Binding SetPositionBCommand}"
                                        IsEnabled="{Binding IsNotBusy}"
                                        Background="#1A3A5C" BorderBrush="#2A5A8C"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Style="{StaticResource ZTrackInputStyle}"
                                         Text="{Binding ZPositionB, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="8,0,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="2"
                                           Style="{StaticResource ZTrackLabelStyle}" Text="mm"
                                           Margin="6,0,0,0"/>

                                <!-- 반복 횟수 -->
                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Style="{StaticResource ZTrackLabelStyle}" Text="반복 횟수"
                                           HorizontalAlignment="Center"/>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Style="{StaticResource ZTrackInputStyle}"
                                         Text="{Binding ZTrackRepeat, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="8,0,0,0"/>
                                <TextBlock Grid.Row="4" Grid.Column="2"
                                           Style="{StaticResource ZTrackLabelStyle}" Text="회"
                                           Margin="6,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- 실행 버튼 -->
                        <Button Style="{StaticResource VisionBtnStyle}"
                                Content="Z 트래킹 시작"
                                Command="{Binding FiducialZTrackCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Background="#3A1A5C" BorderBrush="#6A3A8C"
                                Margin="16,0,16,8"/>

                        <!-- 진행 상태 -->
                        <Border Background="#0A1628" BorderBrush="#1C3A52" BorderThickness="1"
                                CornerRadius="6" Margin="16,0,16,8" Padding="14,8">
                            <TextBlock Text="{Binding ZTrackStatus}"
                                       Foreground="#9B59B6" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- 결과 테이블 -->
                        <telerik:RadGridView ItemsSource="{Binding ZTrackResults}"
                                             AutoGenerateColumns="False"
                                             IsReadOnly="True"
                                             ShowGroupPanel="False"
                                             RowIndicatorVisibility="Collapsed"
                                             CanUserFreezeColumns="False"
                                             Margin="16,0,16,12"
                                             MaxHeight="320"
                                             FontSize="12"
                                             FontFamily="Consolas">
                            <telerik:RadGridView.Columns>
                                <telerik:GridViewDataColumn Header="Rep"
                                    DataMemberBinding="{Binding Repeat}" Width="120"/>
                                <telerik:GridViewDataColumn Header="Pos"
                                    DataMemberBinding="{Binding Position}" Width="120"/>
                                <telerik:GridViewDataColumn Header="Z (mm)"
                                    DataMemberBinding="{Binding ZAbsolute, StringFormat=F4}" Width="120"/>
                                <telerik:GridViewDataColumn Header="HC1 ΔX (um)"
                                    DataMemberBinding="{Binding Hc1DeltaXUm, StringFormat=F2}" Width="120"/>
                                <telerik:GridViewDataColumn Header="HC1 ΔY (um)"
                                    DataMemberBinding="{Binding Hc1DeltaYUm, StringFormat=F2}" Width="120"/>
                                <telerik:GridViewDataColumn Header="HC2 ΔX (um)"
                                    DataMemberBinding="{Binding Hc2DeltaXUm, StringFormat=F2}" Width="120"/>
                                <telerik:GridViewDataColumn Header="HC2 ΔY (um)"
                                    DataMemberBinding="{Binding Hc2DeltaYUm, StringFormat=F2}" Width="120"/>
                            </telerik:RadGridView.Columns>
                        </telerik:RadGridView>

                    </StackPanel>
                </ScrollViewer>

                <!-- 하단 상태바 -->
                <Border Grid.Row="2"
                        Background="#0A1628" BorderBrush="#2A5A8C" BorderThickness="1"
                        CornerRadius="6" Margin="12,8,12,12" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="상태 " Foreground="#5E8BAA" FontSize="14"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Foreground="#3498DB" FontSize="14"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Style="{StaticResource VisionBtnStyle}"
                                Content="중지" Width="80" Height="36"
                                Command="{Binding StopCommand}"
                                Background="#5A1A1A" BorderBrush="#8A2A2A"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
