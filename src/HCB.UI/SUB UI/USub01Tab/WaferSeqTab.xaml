<UserControl x:Class="HCB.UI.WaferSeqTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:HCB.UI"
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
      mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PanelTabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#5E8BAA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2A5A8C"/>
                                <Setter Property="Foreground" Value="#ECF0F1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="#ECF0F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Preparation Sequence -->
        <ContentControl x:Name="PreparationContent" Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Section 1: Wafer Map (3/5) -->
            <Border Grid.Column="0" Background="#0D1B2A" CornerRadius="8" Margin="0,0,3,0"
                    BorderBrush="#1C3A52" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A3A5C" CornerRadius="4" Padding="10,4"
                            HorizontalAlignment="Center" Margin="0,10,0,6">
                        <TextBlock Text="WAFER MAP" Foreground="#3498DB" FontSize="13" FontWeight="Bold"/>
                    </Border>

                    <local:WaferMapControl x:Name="WaferMap" Grid.Row="1" Margin="10"
                                           ItemsSource="{Binding DieList}"/>
                </Grid>
            </Border>

            <!-- Section 2: Info / Setting Panel (2/5) -->
            <Border Grid.Column="1" Background="#0D1B2A" CornerRadius="8" Margin="3,0,0,0"
                    BorderBrush="#1C3A52" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tab Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8,12,0">
                        <RadioButton x:Name="TabInfo" Content="Info"
                                     Style="{StaticResource PanelTabButton}" IsChecked="True"
                                     GroupName="PanelTab"/>
                        <RadioButton x:Name="TabSetting" Content="Setting"
                                     Style="{StaticResource PanelTabButton}"
                                     GroupName="PanelTab"/>
                    </StackPanel>

                    <Rectangle Grid.Row="1" Height="1" Fill="#1C3A52" Margin="12,0"/>

                    <!-- Info Content -->
                    <Grid Grid.Row="2" Margin="16">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=TabInfo}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- 다이 미선택 상태 -->
                        <TextBlock Text="다이를 선택해주세요"
                                   Foreground="#5E8BAA" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDieSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 선택된 다이 정보 -->
                        <DockPanel Visibility="{Binding HasDieSelected, Converter={StaticResource BoolToVis}}">
                            <telerik:RadButton DockPanel.Dock="Bottom" Content="BONDING"
                                Command="{Binding BondingCommand}"
                                Height="48" FontSize="16" FontWeight="Bold"
                                Margin="0,16,0,0"/>

                            <StackPanel>
                                <Border Background="#1A3A5C" CornerRadius="4" Padding="10,4"
                                        HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <TextBlock Text="SELECTED DIE" Foreground="#3498DB"
                                               FontSize="12" FontWeight="Bold"/>
                                </Border>

                                <Border Background="#0A1628" CornerRadius="6" Padding="14"
                                        BorderBrush="#1C3A52" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Row"
                                                   Foreground="#5E8BAA" FontSize="13" Margin="0,0,20,10"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding SelectedDie.Row}"
                                                   Foreground="#ECF0F1" FontSize="13" Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Column"
                                                   Foreground="#5E8BAA" FontSize="13" Margin="0,0,20,10"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding SelectedDie.Col}"
                                                   Foreground="#ECF0F1" FontSize="13" Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Position X"
                                                   Foreground="#5E8BAA" FontSize="13" Margin="0,0,20,10"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                   Text="{Binding SelectedDie.PositionX, StringFormat=F4}"
                                                   Foreground="#ECF0F1" FontSize="13" Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Position Y"
                                                   Foreground="#5E8BAA" FontSize="13" Margin="0,0,20,10"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1"
                                                   Text="{Binding SelectedDie.PositionY, StringFormat=F4}"
                                                   Foreground="#ECF0F1" FontSize="13" Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Status"
                                                   Foreground="#5E8BAA" FontSize="13" Margin="0,0,20,0"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1"
                                                   Text="{Binding SelectedDie.Information}"
                                                   Foreground="#2ECC71" FontSize="13"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Grid>

                    <!-- Setting Content -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="16">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=TabSetting}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <!-- Wafer Settings -->
                            <Border Background="#1A3A5C" CornerRadius="4" Padding="10,4"
                                    HorizontalAlignment="Left" Margin="0,0,0,12">
                                <TextBlock Text="WAFER SETTINGS" Foreground="#3498DB"
                                           FontSize="12" FontWeight="Bold"/>
                            </Border>

                            <Border Background="#0A1628" CornerRadius="6" Padding="14" Margin="0,0,0,16"
                                    BorderBrush="#1C3A52" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Wafer Size"
                                               Foreground="#5E8BAA" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,16,8"/>
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding WaferSize}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Die Size X"
                                               Foreground="#5E8BAA" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,16,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding DieSizeX}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Die Size Y"
                                               Foreground="#5E8BAA" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,16,8"/>
                                    <TextBox Grid.Row="2" Grid.Column="1"
                                             Text="{Binding DieSizeY}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Gap X"
                                               Foreground="#5E8BAA" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,16,8"/>
                                    <TextBox Grid.Row="3" Grid.Column="1"
                                             Text="{Binding GapX}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Gap Y"
                                               Foreground="#5E8BAA" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <TextBox Grid.Row="4" Grid.Column="1"
                                             Text="{Binding GapY}"/>
                                </Grid>
                            </Border>

                            <!-- Center Position -->
                            <Border Background="#1A3A5C" CornerRadius="4" Padding="10,4"
                                    HorizontalAlignment="Left" Margin="0,0,0,12">
                                <TextBlock Text="CENTER POSITION" Foreground="#3498DB"
                                           FontSize="12" FontWeight="Bold"/>
                            </Border>

                            <Border Background="#0A1628" CornerRadius="6" Padding="14" Margin="0,0,0,16"
                                    BorderBrush="#1C3A52" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Center X"
                                               Foreground="#5E8BAA" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,16,8"/>
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding CenterX}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Center Y"
                                               Foreground="#5E8BAA" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding CenterY}"/>
                                </Grid>
                            </Border>

                            <!-- Buttons -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <telerik:RadButton Grid.Column="0" Content="Load Recipe"
                                    Command="{Binding LoadRecipeParamsCommand}"
                                    Height="36" FontSize="13"/>
                                <telerik:RadButton Grid.Column="2" Content="Apply"
                                    Command="{Binding ApplyAndSaveCommand}"
                                    Height="36" FontSize="13"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
