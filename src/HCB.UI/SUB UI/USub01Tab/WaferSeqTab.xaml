<UserControl x:Class="HCB.UI.WaferSeqTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:HCB.UI"
      mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Preparation Sequence (코드비하인드에서 주입) -->
        <ContentControl x:Name="PreparationContent" Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="6">
            <Border Background="#0D1B2A" CornerRadius="8" Margin="6"
                    BorderBrush="#1C3A52" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#1A3A5C" CornerRadius="4" Padding="10,4"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="WAFER" Foreground="#3498DB" FontSize="13" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Wafer Sequence 준비 중입니다"
                               Foreground="#ECF0F1" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding RecipeService.UseRecipe.Name, StringFormat='선택된 레시피: {0}'}"
                               Foreground="#5E8BAA" FontSize="13" Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
