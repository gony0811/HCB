<UserControl x:Class="HCB.UI.WaferSeqTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:HCB.UI"
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
      mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SYSTEM/COMMON/Styles/DefaultResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <local:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <Style x:Key="PanelTabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#5E8BAA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2A5A8C"/>
                                <Setter Property="Foreground" Value="#ECF0F1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="#ECF0F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Preparation Sequence -->
        <ContentControl x:Name="PreparationContent" Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Section 1: Wafer Map (3/5) -->
            <Border Grid.Column="0" Background="#0D1B2A" CornerRadius="8" Margin="0,0,3,0"
                    BorderBrush="#1C3A52" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A3A5C" CornerRadius="4" Padding="10,4"
                            HorizontalAlignment="Center" Margin="0,10,0,6">
                        <TextBlock Text="WAFER MAP" Foreground="#3498DB" FontSize="13" FontWeight="Bold"/>
                    </Border>

                    <local:WaferMapControl x:Name="WaferMap" Grid.Row="1" Margin="10"
                                           ItemsSource="{Binding DieList}"/>
                </Grid>
            </Border>

            <!-- Section 2: Info / Setting Panel (2/5) -->
            <Border Grid.Column="1" Background="#0D1B2A" CornerRadius="8" Margin="3,0,0,0"
                    BorderBrush="#1C3A52" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tab Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8,12,0">
                        <RadioButton x:Name="TabInfo" Content="Info"
                                     Style="{StaticResource PanelTabButton}" IsChecked="True"
                                     GroupName="PanelTab"/>
                        <RadioButton x:Name="TabSetting" Content="Setting"
                                     Style="{StaticResource PanelTabButton}"
                                     GroupName="PanelTab"/>
                    </StackPanel>

                    <Rectangle Grid.Row="1" Height="1" Fill="#1C3A52" Margin="12,0"/>

                    <!-- Info Content -->
                    <Grid Grid.Row="2" Margin="16">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=TabInfo}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- 다이 미선택 상태 -->
                        <TextBlock Text="다이를 선택해주세요"
                                   Foreground="#5E8BAA" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDieSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 선택된 다이 정보 -->
                        <DockPanel Visibility="{Binding HasDieSelected, Converter={StaticResource BoolToVis}}">

                            <!-- Bottom: Buttons -->
                            <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                                <!-- BONDING 버튼 (기본 표시, 진행 중 숨김 — CANCEL과 겹치지 않도록 Collapsed) -->
                                <Button Content="BONDING"
                                    Command="{Binding BondingCommand}"
                                    Height="48" FontSize="16" FontWeight="Bold"
                                    Visibility="{Binding IsNotBonding, Converter={StaticResource BoolToVis}}"/>
                                <!-- CANCEL 버튼 (진행 중에만 표시) -->
                                <Button Content="CANCEL"
                                    Command="{Binding CancelBondingCommand}"
                                    Height="48" FontSize="16" FontWeight="Bold"
                                    Foreground="#E74C3C"
                                    Visibility="{Binding IsBonding, Converter={StaticResource BoolToVis}}"/>
                            </Grid>

                            <!-- 선택 Die를 저배/고배 카메라로 보기 (해당 Die 위치로 이동 후 측정) -->
                            <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 이동 + 측정을 수행하므로 본딩·정렬 진행 중에는 비활성(IsBusy) -->
                                <Button Grid.Column="0" Content="저배율로 보기"
                                    Command="{Binding ViewDieLowMagCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                    Height="38" FontSize="13"/>
                                <Button Grid.Column="2" Content="고배율로 보기"
                                    Command="{Binding ViewDieHighMagCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                    Height="38" FontSize="13"/>
                            </Grid>


                            <!-- 이동/측정 상태 -->
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding ScribeCenterStatus}"
                                       TextWrapping="Wrap" Foreground="#F39C12" FontSize="12"
                                       Margin="0,12,0,0"/>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- SELECTED DIE -->
                                    <Border Background="#1A3A5C" CornerRadius="4" Padding="10,4"
                                            HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <TextBlock Text="SELECTED DIE" Foreground="#3498DB"
                                                   FontSize="12" FontWeight="Bold"/>
                                    </Border>

                                    <Border Background="#0A1628" CornerRadius="6" Padding="14"
                                            BorderBrush="#1C3A52" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Row"
                                                       Foreground="#5E8BAA" FontSize="13" Margin="0,0,20,10"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding SelectedDie.Row}"
                                                       Foreground="#ECF0F1" FontSize="13" Margin="0,0,0,10"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Column"
                                                       Foreground="#5E8BAA" FontSize="13" Margin="0,0,20,10"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                       Text="{Binding SelectedDie.Col}"
                                                       Foreground="#ECF0F1" FontSize="13" Margin="0,0,0,10"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Position X"
                                                       Foreground="#5E8BAA" FontSize="13" Margin="0,0,20,10"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1"
                                                       Text="{Binding SelectedDie.PositionX, StringFormat=F4}"
                                                       Foreground="#ECF0F1" FontSize="13" Margin="0,0,0,10"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Position Y"
                                                       Foreground="#5E8BAA" FontSize="13" Margin="0,0,20,10"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1"
                                                       Text="{Binding SelectedDie.PositionY, StringFormat=F4}"
                                                       Foreground="#ECF0F1" FontSize="13" Margin="0,0,0,10"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Status"
                                                       Foreground="#5E8BAA" FontSize="13" Margin="0,0,20,0"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1"
                                                       Text="{Binding SelectedDie.Information}"
                                                       Foreground="#2ECC71" FontSize="13"/>
                                        </Grid>
                                    </Border>

                                    <!-- SEQUENCE PROGRESS (본딩 진행 중에만 표시) -->
                                    <StackPanel Margin="0,16,0,0"
                                                Visibility="{Binding IsBonding, Converter={StaticResource BoolToVis}}">
                                        <Border Background="#1A3A5C" CornerRadius="4" Padding="10,4"
                                                HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <TextBlock Text="SEQUENCE PROGRESS" Foreground="#3498DB"
                                                       FontSize="12" FontWeight="Bold"/>
                                        </Border>

                                        <Border Background="#0A1628" CornerRadius="6" Padding="10"
                                                BorderBrush="#1C3A52" BorderThickness="1">
                                            <StackPanel>
                                                <!-- Step 1: 저배율 보정 + Pickup -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <local:StepLamp Grid.Column="0" Style="{StaticResource StepLampStyle}"
                                                        State="{Binding StepSeqTab.TopLowAlignState}" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="저배율 보정 + Pick Up"
                                                               Foreground="#ECF0F1" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StepSeqTab.TopLowAlignElapsed}"
                                                               Foreground="#F39C12" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                </Grid>
                                                <!-- Step 2: 고배율 (Top) -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <local:StepLamp Grid.Column="0" Style="{StaticResource StepLampStyle}"
                                                        State="{Binding StepSeqTab.TopHighAlignState}" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="고배율 측정 (Top)"
                                                               Foreground="#ECF0F1" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StepSeqTab.TopHighAlignElapsed}"
                                                               Foreground="#F39C12" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                </Grid>
                                                <!-- Step 3: 고배율 (Btm) -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <local:StepLamp Grid.Column="0" Style="{StaticResource StepLampStyle}"
                                                        State="{Binding StepSeqTab.BtmHighAlignState}" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="고배율 측정 (Btm)"
                                                               Foreground="#ECF0F1" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StepSeqTab.BtmHighAlignElapsed}"
                                                               Foreground="#F39C12" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                </Grid>
                                                <!-- Step 4: 보정 -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <local:StepLamp Grid.Column="0" Style="{StaticResource StepLampStyle}"
                                                        State="{Binding StepSeqTab.TopCorrState}" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="보정"
                                                               Foreground="#ECF0F1" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StepSeqTab.TopCorrElapsed}"
                                                               Foreground="#F39C12" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                </Grid>
                                                <!-- Step 5: 본딩 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <local:StepLamp Grid.Column="0" Style="{StaticResource StepLampStyle}"
                                                        State="{Binding StepSeqTab.TopBondingState}" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="본딩"
                                                               Foreground="#ECF0F1" FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StepSeqTab.TopBondingElapsed}"
                                                               Foreground="#F39C12" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>

                    <!-- Setting Content -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="16">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=TabSetting}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <!-- Wafer Settings -->
                            <Border Background="#1A3A5C" CornerRadius="4" Padding="10,4"
                                    HorizontalAlignment="Left" Margin="0,0,0,12">
                                <TextBlock Text="WAFER SETTINGS" Foreground="#3498DB"
                                           FontSize="12" FontWeight="Bold"/>
                            </Border>

                            <Border Background="#0A1628" CornerRadius="6" Padding="14" Margin="0,0,0,16"
                                    BorderBrush="#1C3A52" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Wafer Size"
                                               Foreground="#5E8BAA" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,16,8"/>
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding WaferSize}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Die Size X"
                                               Foreground="#5E8BAA" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,16,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding DieSizeX}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Die Size Y"
                                               Foreground="#5E8BAA" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,16,8"/>
                                    <TextBox Grid.Row="2" Grid.Column="1"
                                             Text="{Binding DieSizeY}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Gap X"
                                               Foreground="#5E8BAA" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,16,8"/>
                                    <TextBox Grid.Row="3" Grid.Column="1"
                                             Text="{Binding GapX}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Gap Y"
                                               Foreground="#5E8BAA" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <TextBox Grid.Row="4" Grid.Column="1"
                                             Text="{Binding GapY}"/>
                                </Grid>
                            </Border>

                            <!-- Buttons -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Load Recipe"
                                    Command="{Binding LoadRecipeParamsCommand}"
                                    Height="36" FontSize="13"/>
                                <Button Grid.Column="2" Content="Apply"
                                    Command="{Binding ApplyAndSaveCommand}"
                                    Height="36" FontSize="13"/>
                            </Grid>

                            <!-- ═══════════ WAFER 중심 찾기 (Scribeline) ═══════════ -->
                            <Border Background="#1A3A5C" CornerRadius="4" Padding="10,4"
                                    HorizontalAlignment="Left" Margin="0,20,0,12">
                                <TextBlock Text="WAFER 중심 찾기 (Scribeline)" Foreground="#3498DB"
                                           FontSize="12" FontWeight="Bold"/>
                            </Border>

                            <!-- 측정 결과 -->
                            <Border Background="#0A1628" CornerRadius="6" Padding="14" Margin="0,0,0,12"
                                    BorderBrush="#1C3A52" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="상태"
                                               Foreground="#5E8BAA" FontSize="13" Margin="0,0,20,8"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding ScribeCenterStatus}" TextWrapping="Wrap"
                                               Foreground="#F39C12" FontSize="13" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="측정 오프셋 (µm)"
                                               Foreground="#5E8BAA" FontSize="13" Margin="0,0,20,8"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding ScribeOffsetXUm, StringFormat=F1}"
                                                   Foreground="#ECF0F1" FontSize="13" FontFamily="Consolas"/>
                                        <TextBlock Text=", " Foreground="#5E8BAA" FontSize="13"/>
                                        <TextBlock Text="{Binding ScribeOffsetYUm, StringFormat=F1}"
                                                   Foreground="#ECF0F1" FontSize="13" FontFamily="Consolas"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="교차점 (X,Y)"
                                               Foreground="#5E8BAA" FontSize="13" Margin="0,0,20,8"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding ScribeAbsX, StringFormat=F4}"
                                                   Foreground="#ECF0F1" FontSize="13" FontFamily="Consolas"/>
                                        <TextBlock Text=", " Foreground="#5E8BAA" FontSize="13"/>
                                        <TextBlock Text="{Binding ScribeAbsY, StringFormat=F4}"
                                                   Foreground="#ECF0F1" FontSize="13" FontFamily="Consolas"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="저배 센터 (X,Y)"
                                               Foreground="#5E8BAA" FontSize="13" Margin="0,0,20,8"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding CenterX, StringFormat=F4}"
                                                   Foreground="#3498DB" FontSize="13" FontFamily="Consolas"/>
                                        <TextBlock Text=", " Foreground="#5E8BAA" FontSize="13"/>
                                        <TextBlock Text="{Binding CenterY, StringFormat=F4}"
                                                   Foreground="#3498DB" FontSize="13" FontFamily="Consolas"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="고배 센터 (X,Y)"
                                               Foreground="#5E8BAA" FontSize="13" Margin="0,0,20,0"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding HighCenterX, StringFormat=F4}"
                                                   Foreground="#2ECC71" FontSize="13" FontFamily="Consolas"/>
                                        <TextBlock Text=", " Foreground="#5E8BAA" FontSize="13"/>
                                        <TextBlock Text="{Binding HighCenterY, StringFormat=F4}"
                                                   Foreground="#2ECC71" FontSize="13" FontFamily="Consolas"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 1차: 저배율 3점(WAFER_ALIGN_1/2/3) 엣지 자동 측정 결과 -->
                            <Border Background="#0A1628" CornerRadius="6" Padding="14" Margin="0,0,0,8"
                                    BorderBrush="#1C3A52" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="1차 · 저배율 3점(WAFER_ALIGN_1/2/3) 엣지 측정"
                                               Foreground="#5E8BAA" FontSize="12" Margin="0,0,0,8"/>

                                    <!-- 3점 측정값 표시 (1차 버튼 실행 시 자동 이동·측정) -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ALIGN_1"
                                                   Foreground="#5E8BAA" FontSize="12" Margin="0,0,16,4"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EdgePoint12Text}"
                                                   Foreground="#ECF0F1" FontSize="12" FontFamily="Consolas" Margin="0,0,0,4"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="ALIGN_2"
                                                   Foreground="#5E8BAA" FontSize="12" Margin="0,0,16,4"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EdgePoint04Text}"
                                                   Foreground="#ECF0F1" FontSize="12" FontFamily="Consolas" Margin="0,0,0,4"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ALIGN_3"
                                                   Foreground="#5E8BAA" FontSize="12" Margin="0,0,16,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EdgePoint07Text}"
                                                   Foreground="#ECF0F1" FontSize="12" FontFamily="Consolas"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2차: Scribeline 정렬/Theta 설정 -->
                            <Border Background="#0A1628" CornerRadius="6" Padding="14" Margin="0,0,0,8"
                                    BorderBrush="#1C3A52" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="2차 · Scribeline 정렬/Theta 설정"
                                               Foreground="#5E8BAA" FontSize="12" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="초기 Shift X (mm)"
                                                   Foreground="#5E8BAA" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,16,8"/>
                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                 Text="{Binding ScribeShiftX}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="초기 Shift Y (mm)"
                                                   Foreground="#5E8BAA" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,16,8"/>
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding ScribeShiftY}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="스텝당 Die 수"
                                                   Foreground="#5E8BAA" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,16,8"/>
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 Text="{Binding ScribeStepDies}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Die당 수렴 반복"
                                                   Foreground="#5E8BAA" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,16,8"/>
                                        <TextBox Grid.Row="3" Grid.Column="1"
                                                 Text="{Binding ScribeConvergeIter}" Margin="0,0,0,8"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="수렴 임계각 (°)"
                                                   Foreground="#5E8BAA" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <TextBox Grid.Row="4" Grid.Column="1"
                                                 Text="{Binding ScribeThetaMinDeg}"/>
                                    </Grid>

                                    <!-- 측정 기울기 -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="측정 기울기 (°)"
                                                   Foreground="#5E8BAA" FontSize="13" Margin="0,0,16,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ScribeThetaAngleDeg, StringFormat=F4}"
                                                   Foreground="#ECF0F1" FontSize="13" FontFamily="Consolas"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- ═══════════ WAFER THETA 보정 (HC1 AlignMark) ═══════════ -->
                            <Border Background="#1A3A5C" CornerRadius="4" Padding="10,4"
        HorizontalAlignment="Left" Margin="0,20,0,12">
                                <TextBlock Text="WAFER THETA 보정 (HC1 AlignMark)" Foreground="#3498DB"
               FontSize="12" FontWeight="Bold"/>
                            </Border>

                            <!-- 옵션 -->
                            <Border Background="#0A1628" CornerRadius="6" Padding="14" Margin="0,0,0,12"
        BorderBrush="#1C3A52" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="쉬프트 Die 수"
                   Foreground="#5E8BAA" FontSize="13"
                   VerticalAlignment="Center" Margin="0,0,16,8"/>
                                    <TextBox Grid.Row="0" Grid.Column="1"
                 Text="{Binding ThetaShiftDies}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="수렴 임계각 (°)"
                   Foreground="#5E8BAA" FontSize="13"
                   VerticalAlignment="Center" Margin="0,0,16,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding ThetaMinDeg}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Y 탐색 스텝 (mm)"
                   Foreground="#5E8BAA" FontSize="13"
                   VerticalAlignment="Center" Margin="0,0,16,8"/>
                                    <TextBox Grid.Row="2" Grid.Column="1"
                 Text="{Binding ThetaSearchStepMm}" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Y 탐색 범위 (±mm)"
                   Foreground="#5E8BAA" FontSize="13"
                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <TextBox Grid.Row="3" Grid.Column="1"
                 Text="{Binding ThetaSearchRangeMm}"/>
                                </Grid>
                            </Border>

                            <!-- 결과 -->
                            <Border Background="#0A1628" CornerRadius="6" Padding="14" Margin="0,0,0,12"
        BorderBrush="#1C3A52" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="상태"
                   Foreground="#5E8BAA" FontSize="13" Margin="0,0,20,8"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                   Text="{Binding ThetaStatus}" TextWrapping="Wrap"
                   Foreground="#F39C12" FontSize="13" Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="기울기 (°)"
                   Foreground="#5E8BAA" FontSize="13" Margin="0,0,20,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                   Text="{Binding ThetaAngleDeg, StringFormat=F4}"
                   Foreground="#ECF0F1" FontSize="13" FontFamily="Consolas"/>
                                </Grid>
                            </Border>

                            <!-- 4단계 실행 버튼 (1: 저배 3점 중심 / 2: 저배 Scribe Theta / 3: 고배 전환 / 4: 고배 Theta) -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="1차 (저배 중심)"
                                    Command="{Binding FindCenterStep1Command}"
                                    IsEnabled="{Binding IsAligning, Converter={StaticResource InverseBoolConverter}}"
                                    Height="40" FontSize="12" FontWeight="Bold"/>
                                <Button Grid.Column="2" Content="2차 (저배 Theta)"
                                    Command="{Binding FindCenterStep2Command}"
                                    IsEnabled="{Binding IsAligning, Converter={StaticResource InverseBoolConverter}}"
                                    Height="40" FontSize="12" FontWeight="Bold"/>
                                <Button Grid.Column="4" Content="3차 (고배 전환)"
                                    Command="{Binding FindCenterStep3Command}"
                                    IsEnabled="{Binding IsAligning, Converter={StaticResource InverseBoolConverter}}"
                                    Height="40" FontSize="12" FontWeight="Bold"/>
                                <Button Grid.Column="6" Content="4차 (고배 Theta)"
                                    Command="{Binding FindCenterStep4Command}"
                                    IsEnabled="{Binding IsAligning, Converter={StaticResource InverseBoolConverter}}"
                                    Height="40" FontSize="12" FontWeight="Bold"/>
                            </Grid>

                            <!-- 전체 시퀀스 (1차→2차→3차→4차 자동 실행) -->
                            <Button Content="전체 시퀀스 실행 (1~4)"
                                Command="{Binding RunFullSequenceCommand}"
                                IsEnabled="{Binding IsAligning, Converter={StaticResource InverseBoolConverter}}"
                                Background="#1F6F43" Foreground="White"
                                Height="40" FontSize="13" FontWeight="Bold" Margin="0,6,0,0"/>

                            <!-- 동작 취소: 진행 중(중심 찾기 · Theta 보정 · 본딩)일 때만 활성화 -->
                            <Button Content="동작 취소"
                                Command="{Binding CancelOperationCommand}"
                                Background="#C0392B" Foreground="White"
                                Height="40" FontSize="14" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════
             RIGHT SIDEBAR (hover to reveal)
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.RowSpan="2" HorizontalAlignment="Right"
                Panel.ZIndex="5" ClipToBounds="True" Margin="0,6,0,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="16"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                         To="420" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                         To="16" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid Width="420">
                <Border HorizontalAlignment="Left" Width="16"
                        Background="#152238" CornerRadius="6,0,0,6" Opacity="0.8">
                    <Path Data="M 9 6 L 4 12 L 9 18"
                          Stroke="#3498DB" StrokeThickness="1.5" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Margin="16,0,0,0" Background="#0D1B2A"
                        BorderBrush="#1C3A52" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <local:SettingsSidebar/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>
