<UserControl x:Class="HCB.UI.SettingsSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HCB.UI">
    <UserControl.Resources>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ECF0F1"/>
            <Setter Property="CaretBrush" Value="#ECF0F1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- ── MODE SETTINGS ── -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border Background="#14452A" CornerRadius="4" Padding="10,4" Margin="0,0,10,0">
                <TextBlock Text="MODE" Foreground="#2ECC71" FontSize="13" FontWeight="Bold"/>
            </Border>
            <TextBlock Text="Settings" Foreground="#ECF0F1" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </StackPanel>
        <Rectangle Height="1" Fill="#1C3A52" Margin="0,0,0,14"/>

        <!-- Row 1: Average / 2D Mapping -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Height="38" Cursor="Hand"
                    Command="{Binding Settings.ChangeAvgModeCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#1A2332" BorderBrush="#2A3A4A"
                                            BorderThickness="1" CornerRadius="6" Padding="10,4">
                                        <TextBlock x:Name="Txt" Text="Normal" Foreground="#8899AA"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Settings.AvgMode}" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0F6E56"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#1D9E75"/>
                                            <Setter TargetName="Txt" Property="Text" Value="Average"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="2" Height="38" Cursor="Hand"
                    Command="{Binding Settings.Change2DMappingCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#1A2332" BorderBrush="#2A3A4A"
                                            BorderThickness="1" CornerRadius="6" Padding="10,4">
                                        <TextBlock x:Name="Txt" Text="2D Map OFF" Foreground="#8899AA"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Settings.Use2DMapping}" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0F6E56"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#1D9E75"/>
                                            <Setter TargetName="Txt" Property="Text" Value="2D Map ON"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Row 2: Fid Track / 측정 모드 -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Height="38" Cursor="Hand"
                    Command="{Binding Settings.ChangeFiducialTrackingCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#1A2332" BorderBrush="#2A3A4A"
                                            BorderThickness="1" CornerRadius="6" Padding="10,4">
                                        <TextBlock x:Name="Txt" Text="Fid Track OFF" Foreground="#8899AA"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Settings.FiducialTracing}" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0F6E56"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#1D9E75"/>
                                            <Setter TargetName="Txt" Property="Text" Value="Fid Track ON"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="2" Height="38" Cursor="Hand"
                    Command="{Binding Settings.ChangeBtmMeasureModeCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#1A2332" BorderBrush="#2A3A4A"
                                            BorderThickness="1" CornerRadius="6" Padding="10,4">
                                        <TextBlock x:Name="Txt" Text="통합 측정" Foreground="#8899AA"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Settings.BtmIndividualMeasure}" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0F6E56"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#1D9E75"/>
                                            <Setter TargetName="Txt" Property="Text" Value="개별 측정"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Tracing Mode (3-way cycle: Auto / Manual / None) -->
        <Button Margin="0,0,0,8" Height="38" Cursor="Hand"
                Command="{Binding Settings.CycleTracingModeCommand}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#1A2332" BorderBrush="#2A3A4A"
                                        BorderThickness="1" CornerRadius="6" Padding="14,4">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="Ico" Text="○ " Foreground="#8899AA"
                                                   FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Txt" Text="추적 OFF" Foreground="#8899AA"
                                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Settings.TracingMode}" Value="Auto">
                                        <Setter TargetName="Bd" Property="Background" Value="#0F6E56"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#1D9E75"/>
                                        <Setter TargetName="Ico" Property="Text" Value="● "/>
                                        <Setter TargetName="Ico" Property="Foreground" Value="#2ECC71"/>
                                        <Setter TargetName="Txt" Property="Text" Value="자동 추적"/>
                                        <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Settings.TracingMode}" Value="Manual">
                                        <Setter TargetName="Bd" Property="Background" Value="#1A4A6E"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#3498DB"/>
                                        <Setter TargetName="Ico" Property="Text" Value="● "/>
                                        <Setter TargetName="Ico" Property="Foreground" Value="#3498DB"/>
                                        <Setter TargetName="Txt" Property="Text" Value="수동 추적"/>
                                        <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <!-- 우측 피듀셜 닮음변환 보정 (RightFidSimilarity) -->
        <Button Margin="0,0,0,8" Height="38" Cursor="Hand"
                Command="{Binding Settings.ChangeRightFidSimilarityCommand}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#1A2332" BorderBrush="#2A3A4A"
                                        BorderThickness="1" CornerRadius="6" Padding="10,4">
                                    <TextBlock x:Name="Txt" Text="우측Fid 닮음변환 OFF" Foreground="#8899AA"
                                               FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Settings.RightFidSimilarity}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0F6E56"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#1D9E75"/>
                                        <Setter TargetName="Txt" Property="Text" Value="우측Fid 닮음변환 ON"/>
                                        <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <!-- 결과 측정 (MeasureVernier) -->
        <Button Margin="0,0,0,14" Height="38" Cursor="Hand"
                Command="{Binding Settings.ChangeMeasureVernierCommand}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#1A2332" BorderBrush="#2A3A4A"
                                        BorderThickness="1" CornerRadius="6" Padding="10,4">
                                    <TextBlock x:Name="Txt" Text="결과 측정 OFF" Foreground="#8899AA"
                                               FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Settings.MeasureVernierAfterBonding}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0F6E56"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#1D9E75"/>
                                        <Setter TargetName="Txt" Property="Text" Value="결과 측정 ON"/>
                                        <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <!-- ── CSV EXPORT SETTINGS ── -->
        <Rectangle Height="1" Fill="#1C3A52" Margin="0,0,0,14"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Border Background="#1A3A5C" CornerRadius="4" Padding="10,4" Margin="0,0,10,0">
                <TextBlock Text="CSV" Foreground="#3498DB" FontSize="13" FontWeight="Bold"/>
            </Border>
            <TextBlock Text="Export Settings" Foreground="#ECF0F1" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Vernier CSV -->
        <Border Background="#060F1A" CornerRadius="6"
                BorderBrush="#1C3A52" BorderThickness="1"
                Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Vernier CSV" Foreground="#2ECC71" FontSize="12"
                           FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="저장 폴더" Foreground="#5E8BAA" FontSize="11" Margin="0,0,0,3"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#0A1628" BorderBrush="#2A5A8C"
                            BorderThickness="1" CornerRadius="4">
                        <TextBox Text="{Binding Settings.CsvVernierDir, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>
                    </Border>
                    <Button Grid.Column="1" Width="28" Height="26" Margin="4,0,0,0"
                            Background="#1A3A5C" BorderBrush="#2A5A8C" BorderThickness="1"
                            Cursor="Hand" Command="{Binding Settings.BrowseVernierDirCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1" CornerRadius="4">
                                    <TextBlock Text="..." Foreground="#ECF0F1" FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                <TextBlock Text="파일명 ({date} = 날짜)" Foreground="#5E8BAA" FontSize="13" Margin="0,4,0,4"/>
                <Border Background="#0A1628" BorderBrush="#2A5A8C"
                        BorderThickness="1" CornerRadius="4">
                    <TextBox Text="{Binding Settings.CsvVernierFileName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Bonding Data CSV -->
        <Border Background="#060F1A" CornerRadius="6"
                BorderBrush="#1C3A52" BorderThickness="1"
                Padding="12,10">
            <StackPanel>
                <TextBlock Text="Bonding Data CSV" Foreground="#3498DB" FontSize="12"
                           FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="저장 폴더" Foreground="#5E8BAA" FontSize="11" Margin="0,0,0,3"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#0A1628" BorderBrush="#2A5A8C"
                            BorderThickness="1" CornerRadius="4">
                        <TextBox Text="{Binding Settings.CsvDataDir, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>
                    </Border>
                    <Button Grid.Column="1" Width="28" Height="26" Margin="4,0,0,0"
                            Background="#1A3A5C" BorderBrush="#2A5A8C" BorderThickness="1"
                            Cursor="Hand" Command="{Binding Settings.BrowseDataDirCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1" CornerRadius="4">
                                    <TextBlock Text="..." Foreground="#ECF0F1" FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                <TextBlock Text="파일명 ({date} = 날짜)" Foreground="#5E8BAA" FontSize="13" Margin="0,4,0,4"/>
                <Border Background="#0A1628" BorderBrush="#2A5A8C"
                        BorderThickness="1" CornerRadius="4">
                    <TextBox Text="{Binding Settings.CsvDataFileName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}"/>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
