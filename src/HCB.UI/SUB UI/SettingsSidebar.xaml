<UserControl x:Class="HCB.UI.SettingsSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HCB.UI">
    <UserControl.Resources>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ECF0F1"/>
            <Setter Property="CaretBrush" Value="#ECF0F1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- ── MODE SETTINGS ── -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border Background="#14452A" CornerRadius="4" Padding="10,4" Margin="0,0,10,0">
                <TextBlock Text="MODE" Foreground="#2ECC71" FontSize="13" FontWeight="Bold"/>
            </Border>
            <TextBlock Text="Settings" Foreground="#ECF0F1" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </StackPanel>
        <Rectangle Height="1" Fill="#1C3A52" Margin="0,0,0,14"/>

        <!-- Row 1: Average / 2D Mapping -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Height="38" Cursor="Hand"
                    Command="{Binding Settings.ChangeAvgModeCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#1A2332" BorderBrush="#2A3A4A"
                                            BorderThickness="1" CornerRadius="6" Padding="10,4">
                                        <TextBlock x:Name="Txt" Text="Normal" Foreground="#8899AA"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Settings.AvgMode}" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0F6E56"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#1D9E75"/>
                                            <Setter TargetName="Txt" Property="Text" Value="Average"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="2" Height="38" Cursor="Hand"
                    Command="{Binding Settings.Change2DMappingCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#1A2332" BorderBrush="#2A3A4A"
                                            BorderThickness="1" CornerRadius="6" Padding="10,4">
                                        <TextBlock x:Name="Txt" Text="2D Map OFF" Foreground="#8899AA"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Settings.Use2DMapping}" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0F6E56"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#1D9E75"/>
                                            <Setter TargetName="Txt" Property="Text" Value="2D Map ON"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Row 2: Fid Track / 측정 모드 -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Height="38" Cursor="Hand"
                    Command="{Binding Settings.ChangeFiducialTrackingCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#1A2332" BorderBrush="#2A3A4A"
                                            BorderThickness="1" CornerRadius="6" Padding="10,4">
                                        <TextBlock x:Name="Txt" Text="Fid Track OFF" Foreground="#8899AA"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Settings.FiducialTracing}" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0F6E56"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#1D9E75"/>
                                            <Setter TargetName="Txt" Property="Text" Value="Fid Track ON"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <Button Grid.Column="2" Height="38" Cursor="Hand"
                    Command="{Binding Settings.ChangeBtmMeasureModeCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#1A2332" BorderBrush="#2A3A4A"
                                            BorderThickness="1" CornerRadius="6" Padding="10,4">
                                        <TextBlock x:Name="Txt" Text="통합 측정" Foreground="#8899AA"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Settings.BtmIndividualMeasure}" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#0F6E56"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#1D9E75"/>
                                            <Setter TargetName="Txt" Property="Text" Value="개별 측정"/>
                                            <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Tracing Mode (2-way cycle: Manual / None) -->
        <Button Margin="0,0,0,8" Height="38" Cursor="Hand"
                Command="{Binding Settings.CycleTracingModeCommand}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#1A2332" BorderBrush="#2A3A4A"
                                        BorderThickness="1" CornerRadius="6" Padding="14,4">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="Ico" Text="○ " Foreground="#8899AA"
                                                   FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Txt" Text="CAL OFF" Foreground="#8899AA"
                                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Settings.TracingMode}" Value="Manual">
                                        <Setter TargetName="Bd" Property="Background" Value="#1A4A6E"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#3498DB"/>
                                        <Setter TargetName="Ico" Property="Text" Value="● "/>
                                        <Setter TargetName="Ico" Property="Foreground" Value="#3498DB"/>
                                        <Setter TargetName="Txt" Property="Text" Value="CAL ON"/>
                                        <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <!-- 우측 피듀셜 닮음변환 보정 (RightFidSimilarity) -->
        <Button Margin="0,0,0,8" Height="38" Cursor="Hand"
                Command="{Binding Settings.ChangeRightFidSimilarityCommand}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#1A2332" BorderBrush="#2A3A4A"
                                        BorderThickness="1" CornerRadius="6" Padding="10,4">
                                    <TextBlock x:Name="Txt" Text="우측Fid 닮음변환 OFF" Foreground="#8899AA"
                                               FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Settings.RightFidSimilarity}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0F6E56"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#1D9E75"/>
                                        <Setter TargetName="Txt" Property="Text" Value="우측Fid 닮음변환 ON"/>
                                        <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <!-- 피듀셜 중심 강체 정렬 (FidCenterAlign) -->
        <Button Margin="0,0,0,8" Height="38" Cursor="Hand"
                Command="{Binding Settings.ChangeFidCenterAlignCommand}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#1A2332" BorderBrush="#2A3A4A"
                                        BorderThickness="1" CornerRadius="6" Padding="10,4">
                                    <TextBlock x:Name="Txt" Text="피듀셜중심 정렬 OFF" Foreground="#8899AA"
                                               FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Settings.FidCenterAlign}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0F6E56"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#1D9E75"/>
                                        <Setter TargetName="Txt" Property="Text" Value="피듀셜중심 정렬 ON"/>
                                        <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <!-- 결과 측정 (MeasureVernier) -->
        <Button Margin="0,0,0,14" Height="38" Cursor="Hand"
                Command="{Binding Settings.ChangeMeasureVernierCommand}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#1A2332" BorderBrush="#2A3A4A"
                                        BorderThickness="1" CornerRadius="6" Padding="10,4">
                                    <TextBlock x:Name="Txt" Text="결과 측정 OFF" Foreground="#8899AA"
                                               FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Settings.MeasureVernierAfterBonding}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0F6E56"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#1D9E75"/>
                                        <Setter TargetName="Txt" Property="Text" Value="결과 측정 ON"/>
                                        <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <!-- 재측정 (ReMeasure — 보정 후 P-TABLE 복귀 재측정 + 재보정) -->
        <Button Margin="0,0,0,14" Height="38" Cursor="Hand"
                Command="{Binding Settings.ChangeReMeasureCommand}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#1A2332" BorderBrush="#2A3A4A"
                                        BorderThickness="1" CornerRadius="6" Padding="10,4">
                                    <TextBlock x:Name="Txt" Text="재측정 OFF" Foreground="#8899AA"
                                               FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Settings.ReMeasureAfterCorr}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0F6E56"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#1D9E75"/>
                                        <Setter TargetName="Txt" Property="Text" Value="재측정 ON"/>
                                        <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <!-- Wafer Vac 전체 On/Off -->
        <Rectangle Height="1" Fill="#1C3A52" Margin="0,0,0,14"/>
        <Button Margin="0,0,0,8" Height="38" Cursor="Hand"
                Command="{Binding WaferVacAllOnOffCommand}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#1A2332" BorderBrush="#2A3A4A"
                                        BorderThickness="1" CornerRadius="6" Padding="14,4">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="Ico" Text="○ " Foreground="#8899AA"
                                                   FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Txt" Text="Wafer Vac ALL OFF" Foreground="#8899AA"
                                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsWaferVacOn}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#0F6E56"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#1D9E75"/>
                                        <Setter TargetName="Ico" Property="Text" Value="● "/>
                                        <Setter TargetName="Ico" Property="Foreground" Value="#2ECC71"/>
                                        <Setter TargetName="Txt" Property="Text" Value="Wafer Vac ALL ON"/>
                                        <Setter TargetName="Txt" Property="Foreground" Value="#E1F5EE"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </StackPanel>
</UserControl>
