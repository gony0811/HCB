                                <Rectangle Height="1" Fill="#1C3A52" Margin="0,0,0,10"/>

                                <TextBlock Text="저장 폴더" Foreground="#5E8BAA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding Settings.CsvCamHcroQueryDir, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBox}"
                                             ToolTip="{Binding Settings.CsvCamHcroQueryDir}"/>
                                    <Button Grid.Column="1" Content="..."
                                            Command="{Binding Settings.BrowseCamHcroQueryDirCommand}"
                                            Width="34" Margin="4,0,0,0"/>
                                </Grid>

                                <TextBlock Text="카메라거리 파일명" Foreground="#5E8BAA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Settings.CsvCamDistFileName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"/>

                                <TextBlock Text="회전중심 파일명" Foreground="#5E8BAA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Settings.CsvHcroFileName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBox}" Margin="0,0,0,4"/>
                                <TextBlock Text="{}{date}, {time} 토큰 사용 가능" Foreground="#5E8BAA" FontSize="10" Margin="0,0,0,12"/>

                                <TextBlock Text="정렬 (날짜)" Foreground="#5E8BAA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <telerik:RadComboBox SelectedIndex="{Binding CsvSortOrderIndex, Mode=TwoWay}"
                                                     Margin="0,0,0,12">
                                    <telerik:RadComboBoxItem Content="오름차순 (과거→최신)"/>
                                    <telerik:RadComboBoxItem Content="내림차순 (최신→과거)"/>
                                </telerik:RadComboBox>

                                <Button Content="카메라거리 CSV (검색 전체)"
                                        Style="{StaticResource SearchButton}"
                                        Command="{Binding ExportCamDistCsvCommand}"
                                        Margin="0,0,0,8"/>
                                <Button Content="회전중심 CSV (검색 전체)"
                                        Style="{StaticResource SearchButton}"
                                        Command="{Binding ExportHcroCsvCommand}"/>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Page>
