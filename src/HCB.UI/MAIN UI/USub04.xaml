<Page x:Class="HCB.UI.USub04"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
      xmlns:local="clr-namespace:HCB.UI"
      mc:Ignorable="d"
      Title="USub04">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SYSTEM/Common/Styles/DefaultResource.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- DataGrid 공통 -->
            <Style x:Key="LogDataGrid" TargetType="DataGrid">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="#0A1628"/>
                <Setter Property="Foreground" Value="#ECF0F1"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#1C3A52"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            </Style>

            <Style x:Key="LogColumnHeader" TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="Background" Value="#0A1628"/>
                <Setter Property="Foreground" Value="#5E8BAA"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderBrush" Value="#1C3A52"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="10,7"/>
            </Style>

            <Style x:Key="LogCell" TargetType="DataGridCell"
                   BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- 검색 버튼 -->
            <Style x:Key="SearchButton" TargetType="Button">
                <Setter Property="Height" Value="34"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#ECF0F1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="#0F3460"
                                    BorderBrush="#2A5A8C"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1A4A7A"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3498DB"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#0A2040"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- CSV 저장 폴더·파일명 입력용 다크 TextBox (포커스 시 흰 배경 방지) -->
            <Style x:Key="DarkTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="#0A1628"/>
                <Setter Property="Foreground" Value="#ECF0F1"/>
                <Setter Property="CaretBrush" Value="#ECF0F1"/>
                <Setter Property="SelectionBrush" Value="#2A5A8C"/>
                <Setter Property="BorderBrush" Value="#1C3A52"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#2A5A8C"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3498DB"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#6B7280"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 타이틀 -->
        <TextBlock Text="로그"
                   FontSize="24" FontWeight="SemiBold" Foreground="#ECF0F1"
                   Grid.Row="0"
                   Margin="6,10,6,10" VerticalAlignment="Center"/>

        <!-- ── 로그 탭 ── -->
        <TabControl Grid.Row="1" Margin="6,0,6,6" Background="Transparent">

            <!-- ════════ 탭 1 : 알람 히스토리 ════════ -->
            <TabItem Header="알람 히스토리">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.85*"/>
                        <ColumnDefinition Width="0.15*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── 메인 알람 히스토리 그리드 ── -->
                    <Border Grid.Column="0"
                            Background="#0D1B2A" BorderBrush="#1C3A52" BorderThickness="1"
                            CornerRadius="8" Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <local:HeaderBar Grid.Row="0" Margin="12,10,12,0" Title="알람 히스토리"/>
                            <Rectangle Grid.Row="0" Height="1" Fill="#1C3A52"
                                       VerticalAlignment="Bottom" Margin="12,32,12,0"/>

                            <DataGrid Grid.Row="1"
                                      Style="{StaticResource LogDataGrid}"
                                      ColumnHeaderStyle="{StaticResource LogColumnHeader}"
                                      CellStyle="{StaticResource LogCell}"
                                      ItemsSource="{Binding AlarmHistoryList}"
                                      SelectedItem="{Binding SelectedHistory, Mode=TwoWay}"
                                      Margin="8,6,8,4">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="에러 번호" Binding="{Binding Code}"                                      Width="*"/>
                                    <DataGridTextColumn Header="에러 내용" Binding="{Binding Name}"                                      Width="4*"/>
                                    <DataGridTextColumn Header="레벨"     Binding="{Binding Level}"                                     Width="*"/>
                                    <DataGridTextColumn Header="상태"     Binding="{Binding Status}"                                    Width="*"/>
                                    <DataGridTextColumn Header="발생 날짜" Binding="{Binding CreateDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="*"/>
                                    <DataGridTextColumn Header="발생 시각" Binding="{Binding CreateTime}"                                 Width="*"/>
                                    <DataGridTextColumn Header="해제 시각" Binding="{Binding ResetTime}"                                  Width="*"/>
                                    <DataGridTextColumn Header="조치 시간" Binding="{Binding AcknowledgeTime}"                            Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 페이저 -->
                            <telerik:RadDataPager Grid.Row="2"
                                                  Margin="8,0,8,8"
                                                  DisplayMode="FirstLastPreviousNextNumeric"
                                                  IsTotalItemCountFixed="False"
                                                  PageSize="{Binding PageSize}"
                                                  ItemCount="{Binding TotalCount}"
                                                  PageIndex="{Binding CurrentPageIndex, Mode=TwoWay}"/>
                        </Grid>
                    </Border>

                    <!-- ── 우측 검색 패널 ── -->
                    <Border Grid.Column="1"
                            Background="#0D1B2A" BorderBrush="#1C3A52" BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <local:HeaderBar Grid.Row="0" Margin="12,10,12,0" Title="검색"/>
                            <Rectangle Grid.Row="0" Height="1" Fill="#1C3A52"
                                       VerticalAlignment="Bottom" Margin="12,32,12,0"/>

                            <StackPanel Grid.Row="1" Margin="12,10,12,12">
                                <TextBlock Text="Begin" Foreground="#5E8BAA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <telerik:RadDatePicker
                                    SelectedValue="{Binding StartSearchDate, Mode=TwoWay}"
                                    InputMode="DatePicker"
                                    Margin="0,0,0,8"/>

                                <TextBlock Text="End" Foreground="#5E8BAA" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <telerik:RadDatePicker
                                    SelectedDate="{Binding EndSearchDate, Mode=TwoWay}"
                                    InputMode="DatePicker"
                                    Margin="0,0,0,12"/>

                                <Button Content="검색"
                                        Style="{StaticResource SearchButton}"
                                        Command="{Binding SearchCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ════════ 탭 2 : 시스템 로그 ════════ -->
            <TabItem Header="시스템 로그">
                <Border Background="#0D1B2A" BorderBrush="#1C3A52" BorderThickness="1"
                        CornerRadius="8" Margin="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <local:HeaderBar Grid.Row="0" Margin="12,10,12,0" Title="시스템 로그"/>
                        <Rectangle Grid.Row="0" Height="1" Fill="#1C3A52"
                                   VerticalAlignment="Bottom" Margin="12,32,12,0"/>

                        <DataGrid Grid.Row="1"
                                  Style="{StaticResource LogDataGrid}"
                                  ColumnHeaderStyle="{StaticResource LogColumnHeader}"
                                  CellStyle="{StaticResource LogCell}"
                                  ItemsSource="{Binding Logs}"
                                  Margin="8,6,8,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time"       Binding="{Binding Timestamp, StringFormat='{}{0:yyyy/MM/dd HH:mm:ss.fff}'}"     Width="220"/>
                                <DataGridTextColumn Header="ThreadId"   Binding="{Binding ThreadId}"      Width="150"/>
                                <DataGridTextColumn Header="LogSource"  Binding="{Binding SourceContext}"  Width="250"/>
                                <DataGridTemplateColumn Header="Level" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Level}" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#ECF0F1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                                <Setter Property="Foreground" Value="#E67E22"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Information">
                                                                <Setter Property="Foreground" Value="#2ECC71"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ════════ 탭 3 : 본딩 정보 ════════ -->
            <TabItem Header="본딩 정보">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.85*"/>
                        <ColumnDefinition Width="0.15*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── 본딩 정보 그리드 ── -->
                    <Border Grid.Column="0"
                            Background="#0D1B2A" BorderBrush="#1C3A52" BorderThickness="1"
                            CornerRadius="8" Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <local:HeaderBar Grid.Row="0" Margin="12,10,12,0" Title="본딩 정보"/>
                            <Rectangle Grid.Row="0" Height="1" Fill="#1C3A52"
                                       VerticalAlignment="Bottom" Margin="12,32,12,0"/>

                            <ScrollViewer Grid.Row="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Margin="8,6,8,4">
                            <DataGrid Style="{StaticResource LogDataGrid}"
                                      ColumnHeaderStyle="{StaticResource LogColumnHeader}"
                                      CellStyle="{StaticResource LogCell}"
                                      ItemsSource="{Binding BondingList}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID"        Binding="{Binding Id}"                                              Width="Auto"/>
                                    <DataGridTextColumn Header="시각"      Binding="{Binding Time, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"   Width="160"/>
                                    <DataGridTextColumn Header="종류"      Binding="{Binding Kind}"                                            Width="Auto"/>
                                    <DataGridTextColumn Header="원본ID"    Binding="{Binding ParentRecordId}"                                  Width="Auto"/>
                                    <DataGridTextColumn Header="평균이동"  Binding="{Binding AvgMode}"                                         Width="Auto"/>
                                    <DataGridTextColumn Header="2D매핑"    Binding="{Binding Use2DMapping}"                                    Width="Auto"/>
                                    <DataGridTextColumn Header="Tracing"   Binding="{Binding TracingMode}"                                     Width="Auto"/>
                                    <DataGridTextColumn Header="Btm개별"   Binding="{Binding UseBtmIndividualMeasure}"                         Width="Auto"/>
                                    <DataGridTextColumn Header="Fid추적"   Binding="{Binding UseFiducialTracking}"                             Width="Auto"/>
                                    <DataGridTextColumn Header="R.Fid닮음" Binding="{Binding UseRightFidSimilarity}"                           Width="Auto"/>
                                    <DataGridTextColumn Header="ResultX"   Binding="{Binding ResultX, StringFormat='{}{0:F4}'}"                Width="110"/>
                                    <DataGridTextColumn Header="ResultY"   Binding="{Binding ResultY, StringFormat='{}{0:F4}'}"                Width="110"/>
                                    <DataGridTextColumn Header="ResultT"   Binding="{Binding ResultT, StringFormat='{}{0:F4}'}"                Width="110"/>
                                    <DataGridTextColumn Header="Vern.X"    Binding="{Binding VernierOffsetX, StringFormat='{}{0:F4}'}"         Width="110"/>
                                    <DataGridTextColumn Header="Vern.Y"    Binding="{Binding VernierOffsetY, StringFormat='{}{0:F4}'}"         Width="110"/>
                                    <DataGridTextColumn Header="Vern.T"    Binding="{Binding VernierOffsetT, StringFormat='{}{0:F4}'}"         Width="110"/>

                                    <!-- ══ 설비 정보 ══ -->
                                    <DataGridTextColumn Header="PcTRad"      Binding="{Binding Equipment.PcTRad, StringFormat='{}{0:F6}'}"      Width="Auto"/>
                                    <DataGridTextColumn Header="Hc1Rad"      Binding="{Binding Equipment.Hc1Rad, StringFormat='{}{0:F6}'}"      Width="Auto"/>
                                    <DataGridTextColumn Header="Hc2Rad"      Binding="{Binding Equipment.Hc2Rad, StringFormat='{}{0:F6}'}"      Width="Auto"/>
                                    <DataGridTextColumn Header="Hcro_X"      Binding="{Binding Equipment.Hcro_X, StringFormat='{}{0:F6}'}"      Width="Auto"/>
                                    <DataGridTextColumn Header="Hcro_Y"      Binding="{Binding Equipment.Hcro_Y, StringFormat='{}{0:F6}'}"      Width="Auto"/>
                                    <DataGridTextColumn Header="Hc2Offset_X" Binding="{Binding Equipment.Hc2Offset_X, StringFormat='{}{0:F6}'}" Width="Auto"/>
                                    <DataGridTextColumn Header="Hc2Offset_Y" Binding="{Binding Equipment.Hc2Offset_Y, StringFormat='{}{0:F6}'}" Width="Auto"/>

                                    <!-- ══ 추가 설정 ══ -->
                                    <DataGridTextColumn Header="OffsetX"     Binding="{Binding Setting.OffsetX, StringFormat='{}{0:F6}'}"       Width="Auto"/>
                                    <DataGridTextColumn Header="OffsetY"     Binding="{Binding Setting.OffsetY, StringFormat='{}{0:F6}'}"       Width="Auto"/>
                                    <DataGridTextColumn Header="OffsetT"     Binding="{Binding Setting.OffsetT, StringFormat='{}{0:F6}'}"       Width="Auto"/>

                                    <!-- ══ 측정 정보 (Top) ══ -->
                                    <DataGridTextColumn Header="TopRF_StageX"  Binding="{Binding Measurement.TopRF_StageX, StringFormat='{}{0:F6}'}"  Width="Auto"/>
                                    <DataGridTextColumn Header="TopRF_StageY"  Binding="{Binding Measurement.TopRF_StageY, StringFormat='{}{0:F6}'}"  Width="Auto"/>
                                    <DataGridTextColumn Header="TopRF_DxCam"   Binding="{Binding Measurement.TopRF_DxCam, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="TopRF_DyCam"   Binding="{Binding Measurement.TopRF_DyCam, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="TopRF_CenterX" Binding="{Binding Measurement.TopRF_CenterX, StringFormat='{}{0:F6}'}" Width="Auto"/>
                                    <DataGridTextColumn Header="TopRF_CenterY" Binding="{Binding Measurement.TopRF_CenterY, StringFormat='{}{0:F6}'}" Width="Auto"/>
                                    <DataGridTextColumn Header="TopRA_StageX"  Binding="{Binding Measurement.TopRA_StageX, StringFormat='{}{0:F6}'}"  Width="Auto"/>
                                    <DataGridTextColumn Header="TopRA_StageY"  Binding="{Binding Measurement.TopRA_StageY, StringFormat='{}{0:F6}'}"  Width="Auto"/>
                                    <DataGridTextColumn Header="TopRA_DxCam"   Binding="{Binding Measurement.TopRA_DxCam, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="TopRA_DyCam"   Binding="{Binding Measurement.TopRA_DyCam, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="TopRA_CenterX" Binding="{Binding Measurement.TopRA_CenterX, StringFormat='{}{0:F6}'}" Width="Auto"/>
                                    <DataGridTextColumn Header="TopRA_CenterY" Binding="{Binding Measurement.TopRA_CenterY, StringFormat='{}{0:F6}'}" Width="Auto"/>
                                    <DataGridTextColumn Header="TopLF_StageX"  Binding="{Binding Measurement.TopLF_StageX, StringFormat='{}{0:F6}'}"  Width="Auto"/>
                                    <DataGridTextColumn Header="TopLF_StageY"  Binding="{Binding Measurement.TopLF_StageY, StringFormat='{}{0:F6}'}"  Width="Auto"/>
                                    <DataGridTextColumn Header="TopLF_DxCam"   Binding="{Binding Measurement.TopLF_DxCam, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="TopLF_DyCam"   Binding="{Binding Measurement.TopLF_DyCam, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="TopLF_CenterX" Binding="{Binding Measurement.TopLF_CenterX, StringFormat='{}{0:F6}'}" Width="Auto"/>
                                    <DataGridTextColumn Header="TopLF_CenterY" Binding="{Binding Measurement.TopLF_CenterY, StringFormat='{}{0:F6}'}" Width="Auto"/>
                                    <DataGridTextColumn Header="TopLA_StageX"  Binding="{Binding Measurement.TopLA_StageX, StringFormat='{}{0:F6}'}"  Width="Auto"/>
                                    <DataGridTextColumn Header="TopLA_StageY"  Binding="{Binding Measurement.TopLA_StageY, StringFormat='{}{0:F6}'}"  Width="Auto"/>
                                    <DataGridTextColumn Header="TopLA_DxCam"   Binding="{Binding Measurement.TopLA_DxCam, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="TopLA_DyCam"   Binding="{Binding Measurement.TopLA_DyCam, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="TopLA_CenterX" Binding="{Binding Measurement.TopLA_CenterX, StringFormat='{}{0:F6}'}" Width="Auto"/>
                                    <DataGridTextColumn Header="TopLA_CenterY" Binding="{Binding Measurement.TopLA_CenterY, StringFormat='{}{0:F6}'}" Width="Auto"/>
                                    <!-- ══ 측정 정보 (Btm) ══ -->
                                    <DataGridTextColumn Header="BtmRF_DxCam"   Binding="{Binding Measurement.BtmRF_DxCam, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="BtmRF_DyCam"   Binding="{Binding Measurement.BtmRF_DyCam, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="BtmRA_DxCam"   Binding="{Binding Measurement.BtmRA_DxCam, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="BtmRA_DyCam"   Binding="{Binding Measurement.BtmRA_DyCam, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="BtmLF_DxCam"   Binding="{Binding Measurement.BtmLF_DxCam, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="BtmLF_DyCam"   Binding="{Binding Measurement.BtmLF_DyCam, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="BtmLA_DxCam"   Binding="{Binding Measurement.BtmLA_DxCam, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="BtmLA_DyCam"   Binding="{Binding Measurement.BtmLA_DyCam, StringFormat='{}{0:F6}'}"   Width="Auto"/>

                                    <!-- ══ 분석 데이터 ══ -->
                                    <DataGridTextColumn Header="P_PC_Fid_DX"    Binding="{Binding Analysis.P_PC_Fid_DX, StringFormat='{}{0:F6}'}"    Width="Auto"/>
                                    <DataGridTextColumn Header="P_PC_Fid_DY"    Binding="{Binding Analysis.P_PC_Fid_DY, StringFormat='{}{0:F6}'}"    Width="Auto"/>
                                    <DataGridTextColumn Header="P_PC_Fid_Dist"  Binding="{Binding Analysis.P_PC_Fid_Dist, StringFormat='{}{0:F6}'}"  Width="Auto"/>
                                    <DataGridTextColumn Header="P_PC_Fid_Theta" Binding="{Binding Analysis.P_PC_Fid_Theta, StringFormat='{}{0:F6}'}" Width="Auto"/>
                                    <DataGridTextColumn Header="P_PC_Align_DX"    Binding="{Binding Analysis.P_PC_Align_DX, StringFormat='{}{0:F6}'}"    Width="Auto"/>
                                    <DataGridTextColumn Header="P_PC_Align_DY"    Binding="{Binding Analysis.P_PC_Align_DY, StringFormat='{}{0:F6}'}"    Width="Auto"/>
                                    <DataGridTextColumn Header="P_PC_Align_Dist"  Binding="{Binding Analysis.P_PC_Align_Dist, StringFormat='{}{0:F6}'}"  Width="Auto"/>
                                    <DataGridTextColumn Header="P_PC_Align_Theta" Binding="{Binding Analysis.P_PC_Align_Theta, StringFormat='{}{0:F6}'}" Width="Auto"/>
                                    <DataGridTextColumn Header="P_HC_Fid_L_X"   Binding="{Binding Analysis.P_HC_Fid_L_X, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="P_HC_Fid_L_Y"   Binding="{Binding Analysis.P_HC_Fid_L_Y, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="P_HC_Fid_R_X"   Binding="{Binding Analysis.P_HC_Fid_R_X, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="P_HC_Fid_R_Y"   Binding="{Binding Analysis.P_HC_Fid_R_Y, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="P_HC_Fid_DX"    Binding="{Binding Analysis.P_HC_Fid_DX, StringFormat='{}{0:F6}'}"    Width="Auto"/>
                                    <DataGridTextColumn Header="P_HC_Fid_DY"    Binding="{Binding Analysis.P_HC_Fid_DY, StringFormat='{}{0:F6}'}"    Width="Auto"/>
                                    <DataGridTextColumn Header="P_HC_Fid_Dist"  Binding="{Binding Analysis.P_HC_Fid_Dist, StringFormat='{}{0:F6}'}"  Width="Auto"/>
                                    <DataGridTextColumn Header="P_HC_Fid_Theta" Binding="{Binding Analysis.P_HC_Fid_Theta, StringFormat='{}{0:F6}'}" Width="Auto"/>
                                    <DataGridTextColumn Header="W_HC_Fid_L_X"   Binding="{Binding Analysis.W_HC_Fid_L_X, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="W_HC_Fid_L_Y"   Binding="{Binding Analysis.W_HC_Fid_L_Y, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="W_HC_Fid_R_X"   Binding="{Binding Analysis.W_HC_Fid_R_X, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="W_HC_Fid_R_Y"   Binding="{Binding Analysis.W_HC_Fid_R_Y, StringFormat='{}{0:F6}'}"   Width="Auto"/>
                                    <DataGridTextColumn Header="W_HC_Fid_DX"    Binding="{Binding Analysis.W_HC_Fid_DX, StringFormat='{}{0:F6}'}"    Width="Auto"/>
